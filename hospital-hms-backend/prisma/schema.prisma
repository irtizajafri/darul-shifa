// ─── Accounts Module ──────────────────────────────────────────────────────────

model AccMainGL {
  id          Int        @id @default(autoincrement())
  code        String     @unique
  name        String
  entityType  String     @default("non-corporate")
  createdAt   DateTime   @default(now())
  subGLs      AccSubGL[]
}

model AccSubGL {
  id         Int              @id @default(autoincrement())
  code       String           @unique
  name       String
  mainGlId   Int
  entityType String           @default("non-corporate")
  createdAt  DateTime         @default(now())
  mainGL     AccMainGL        @relation(fields: [mainGlId], references: [id], onDelete: Cascade)
  mainAccounts AccMainAccount[]
}

model AccMainAccount {
  id            Int             @id @default(autoincrement())
  code          String          @unique
  name          String
  subGlId       Int
  entityType    String          @default("non-corporate")
  createdAt     DateTime        @default(now())
  subGL         AccSubGL        @relation(fields: [subGlId], references: [id], onDelete: Cascade)
  subAccounts   AccSubAccount[]
  inventoryHeadLinks AccPayeeHeadMainAccount[]
}

model AccSubAccount {
  id            Int                    @id @default(autoincrement())
  code          String                 @unique
  name          String
  mainAccountId Int
  entityType    String                 @default("non-corporate")
  createdAt     DateTime               @default(now())
  mainAccount    AccMainAccount         @relation(fields: [mainAccountId], references: [id], onDelete: Cascade)
  payeeHeadLinks AccPayeeHeadAccount[]
  payeeEntries   AccPayeeEntry[]
}

model AccPayeeHead {
  id                     Int                          @id @default(autoincrement())
  name                   String
  sourceType             String                       @default("manual")
  entityType             String                       @default("non-corporate")
  inventorySubcategoryId Int?
  createdAt              DateTime                     @default(now())
  entries                AccPayeeEntry[]
  linkedAccounts         AccPayeeHeadAccount[]
  linkedMainAccounts     AccPayeeHeadMainAccount[]
  inventorySubcategory   InventorySubcategory?        @relation(fields: [inventorySubcategoryId], references: [id])
  // sourceType='surgery': Sub Account is replaced by an admission-number
  // picker and the payee list is Clinic doctors whose staff category matches
  // one of these links (e.g. Surgeon + Anaesthetic under one "Anesthesia and
  // Surgery" Sub GL) — see AccPayeeHeadStaffCategory below.
  staffCategoryLinks     AccPayeeHeadStaffCategory[]
  // sourceType='inventory': lets an Inventory Head also pull in one or more
  // Custom (sourceType='manual') Heads' own manually-typed entries — merged
  // into the same Payee list, alongside the inventory items, when this
  // head's linked Main Account is picked in Voucher Expense.
  linkedCustomHeads      AccPayeeHeadLinkedCustomHead[] @relation("HeadLinkedCustomHeads")
  linkedToHeads          AccPayeeHeadLinkedCustomHead[] @relation("CustomHeadLinkedTo")
}

model AccPayeeHeadLinkedCustomHead {
  id           Int          @id @default(autoincrement())
  headId       Int
  customHeadId Int
  createdAt    DateTime     @default(now())
  head         AccPayeeHead @relation("HeadLinkedCustomHeads", fields: [headId], references: [id], onDelete: Cascade)
  customHead   AccPayeeHead @relation("CustomHeadLinkedTo", fields: [customHeadId], references: [id], onDelete: Cascade)

  @@unique([headId, customHeadId])
}

model AccPayeeHeadMainAccount {
  id            Int            @id @default(autoincrement())
  payeeHeadId   Int
  mainAccountId Int
  createdAt     DateTime       @default(now())
  payeeHead     AccPayeeHead   @relation(fields: [payeeHeadId], references: [id], onDelete: Cascade)
  mainAccount   AccMainAccount @relation(fields: [mainAccountId], references: [id], onDelete: Cascade)

  @@unique([payeeHeadId, mainAccountId])
}

model AccPayeeHeadStaffCategory {
  id              Int                 @id @default(autoincrement())
  payeeHeadId     Int
  staffCategoryId Int
  createdAt       DateTime            @default(now())
  payeeHead       AccPayeeHead        @relation(fields: [payeeHeadId], references: [id], onDelete: Cascade)
  staffCategory   ClinicStaffCategory @relation(fields: [staffCategoryId], references: [id], onDelete: Cascade)

  @@unique([payeeHeadId, staffCategoryId])
}

model AccPayeeHeadAccount {
  id           Int           @id @default(autoincrement())
  payeeHeadId  Int
  subAccountId Int
  createdAt    DateTime      @default(now())
  payeeHead    AccPayeeHead  @relation(fields: [payeeHeadId], references: [id], onDelete: Cascade)
  subAccount   AccSubAccount @relation(fields: [subAccountId], references: [id], onDelete: Cascade)

  @@unique([payeeHeadId, subAccountId])
}

model AccPayeeEntry {
  id           Int            @id @default(autoincrement())
  payeeHeadId  Int
  subAccountId Int?
  name         String
  createdAt    DateTime       @default(now())
  payeeHead    AccPayeeHead   @relation(fields: [payeeHeadId], references: [id], onDelete: Cascade)
  subAccount   AccSubAccount? @relation(fields: [subAccountId], references: [id], onDelete: Cascade)
}

model AccBankAccount {
  id            Int               @id @default(autoincrement())
  bankName      String
  accountNumber String
  entityType    String            @default("non-corporate")
  createdAt     DateTime          @default(now())
  chequeSerials AccChequeSerial[]
  deposits      AccBankDeposit[]
  depositAdjs   AccBankDepositAdj[]
}

model AccBankDeposit {
  id              Int            @id @default(autoincrement())
  bankAccountId   Int
  depositOf       DateTime
  depositDate     DateTime
  depositSlipNo   String?
  depositedBy     String?
  amount          Decimal        @db.Decimal(15, 2)
  entityType      String         @default("non-corporate")
  createdAt       DateTime       @default(now())
  bankAccount     AccBankAccount @relation(fields: [bankAccountId], references: [id])
}

model AccBankDepositAdj {
  id                    Int            @id @default(autoincrement())
  bankAccountId         Int
  postedDepositOf       DateTime
  postedDepositDate     DateTime
  postedDepositSlipNo   String?
  postedDepositedBy     String?
  postedAmount          Decimal        @db.Decimal(15, 2)
  adjDepositDate        DateTime
  adjDepositSlipNo      String?
  adjDepositedBy        String?
  adjAmount             Decimal        @db.Decimal(15, 2)
  adjustedBy            String?
  entityType            String         @default("non-corporate")
  createdAt             DateTime       @default(now())
  bankAccount           AccBankAccount @relation(fields: [bankAccountId], references: [id])
}

model AccChequeSerial {
  id            Int            @id @default(autoincrement())
  bankAccountId Int
  fromSerial    String
  toSerial      String
  createdAt     DateTime       @default(now())
  bankAccount   AccBankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
}

model AccIncomeCategory {
  id         Int      @id @default(autoincrement())
  name       String
  entityType String   @default("non-corporate")
  createdAt  DateTime @default(now())
}

model AccVoucherExpense {
  id          Int                      @id @default(autoincrement())
  voucherNo   String                   @unique
  voucherType String
  voucherDate DateTime
  mode        String
  bankId      Int?
  entityType  String
  totalAmount Decimal                  @db.Decimal(12, 2) @default(0)
  source      String                   @default("manual") // 'manual' | 'draft-auto'
  createdAt   DateTime                 @default(now())
  entries     AccVoucherExpenseEntry[]
  draftItems  AccVoucherExpenseDraft[]
}

// ─── Expense Draft — individual clinic/reception payments saved throughout the
// business day; at 08:00 AM day-close these are grouped by Main GL and each
// group becomes one AccVoucherExpense (source='draft-auto'). ─────────────────
model AccVoucherExpenseDraft {
  id             Int               @id @default(autoincrement())
  businessDate   String            // "YYYY-MM-DD" — which business day this belongs to
  entityType     String            @default("non-corporate")
  mode           String            @default("cash")
  bankId         Int?
  mainGlId       Int
  mainGlName     String            @default("")
  subGlId        Int
  subGlName      String            @default("")
  mainAccountId  Int
  accountCode    String            @default("")
  accountName    String            @default("")
  subAccountId   Int?
  subAccountName String?
  payeeName      String?
  amount         Decimal           @db.Decimal(12, 2)
  chequeNo       String?
  chequeDate     DateTime?
  chequeType     String?
  particulars    String?
  status         String            @default("pending") // 'pending' | 'posted'
  postedVoucherId Int?
  postedVoucher  AccVoucherExpense? @relation(fields: [postedVoucherId], references: [id], onDelete: SetNull)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([businessDate, entityType, status])
  @@index([status])
}

model AccVoucherExpenseEntry {
  id            Int               @id @default(autoincrement())
  voucherId     Int
  voucher       AccVoucherExpense @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  mainGlId      Int
  subGlId       Int
  mainAccountId Int
  subAccountId  Int?
  accountCode   String
  accountName   String
  payeeName     String?
  amount        Decimal           @db.Decimal(12, 2)
  chequeNo      String?
  chequeDate    DateTime?
  chequeType    String?
  particulars   String?
  // Surgery/Anesthesia-type payee heads (see AccPayeeHeadStaffCategory) pick
  // an admission instead of a normal Sub Account — the admission number is
  // kept here so reprints/reports can show which patient this payment was for.
  admissionNo   String?
  createdAt     DateTime          @default(now())

  consultantFeeItems AccVoucherExpenseEntryConsultantFee[]
}

// IPD Consultant Fee payee type (see AccPayeeHead.sourceType='ipd-consultant')
// pays out one or more Final Bill Const Fee doctorFee amounts in a single
// voucher entry — this records exactly which ClinicDischargeBillItem rows
// that entry's Amount was summed from, so they can be flipped isPaid=true
// and never show up as still-owed again.
model AccVoucherExpenseEntryConsultantFee {
  id                    Int                    @id @default(autoincrement())
  voucherExpenseEntryId Int
  voucherExpenseEntry   AccVoucherExpenseEntry @relation(fields: [voucherExpenseEntryId], references: [id], onDelete: Cascade)
  dischargeBillItemId   Int
  dischargeBillItem     ClinicDischargeBillItem @relation(fields: [dischargeBillItemId], references: [id])
  amount                Float
  createdAt             DateTime               @default(now())

  @@index([voucherExpenseEntryId])
  @@index([dischargeBillItemId])
}

model AccVoucherIncome {
