// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String    @id @default(uuid())
  name        String
  email       String    @unique
  password    String
  role        String
  department  String?
  permissions Json      @default("{}")
  isActive     Boolean   @default(true)
  expiresAt    DateTime?
  lastLogin    DateTime?
  lastActivity DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Department {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  employees Employee[]
}

model Employee {
  id                  Int          @id @default(autoincrement())
  empCode             String?      @unique
  firstName           String
  middleName          String?
  lastName            String
  fatherName          String?
  dob                 String?
  gender              String?
  maritalStatus       String?
  spouseName          String?
  nic                 String?
  birthPlace          String?
  beneficiaryName     String?
  beneficiaryRelation String?
  address             String?
  city                String?
  phone               String?
  email               String?      @unique
  reference1          String?
  reference2          String?
  
  departmentId        Int?
  department          Department?  @relation(fields: [departmentId], references: [id])
  departmentText      String?
  role                String?
  status              String?
  appointmentDate     String?
  weeklyHoliday       String?
  workingDays         String?
  disbursement        String?
  salaryMonthly       Float        @default(0)
  allowances          Json?        @default("[]")
  incentive           Float?       @default(0)
  
  dutyType            String?
  dutyRoster          Json?        @default("[]")
  isNightShift        Boolean?     @default(false)
  
  photo               String?      @db.Text
  emergencyContact    String?
  emergencyPhone      String?
  emergencyRelation   String?
  notes               String?

  hasEobi                   Boolean?     @default(false)
  eobiContribution          Float?       @default(0)
  hasSocialSecurity         Boolean?     @default(false)
  socialSecurityContribution Float?      @default(0)
  hasHealthCard             Boolean?     @default(false)
  healthCardContribution    Float?       @default(0)
  hasOtherBenefit           Boolean?     @default(false)
  otherBenefitContribution  Float?       @default(0)
  late                      Float?       @default(0)
  short                     Float?       @default(0)
  qualification             String?

  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  attendances   Attendance[]
  gatepasses    Gatepass[]
  shortleaves   Shortleave[]
  advanceLoans  AdvanceLoan[]
  dependents    EmployeeDependent[]
  issuedGINs    InventoryGIN[]
  maintenances  InventoryMaintenance[]
}

model EmployeeDependent {
  id         Int      @id @default(autoincrement())
  employeeId Int
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  code       String   @default("")
  name       String   @default("")
  relation   String   @default("")
  dob        DateTime?
  gender     String   @default("male")
  status     String   @default("active")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ─── Raw Biometric Punch Logs ─────────────────────────────────────────────────
// Cloud API se aye raw timestamps yahan store hote hain.
// testPairing pehle yahan se padhta hai — cloud se nahi.
model PunchLog {
  id          Int      @id @default(autoincrement())
  empCode     String
  punchTime   DateTime // PKT mein store hoga (UTC+5 converted)
  punchDate   String   // "YYYY-MM-DD" — fast filtering ke liye
  createdAt   DateTime @default(now())

  @@unique([empCode, punchTime]) // duplicate sync se bacho
  @@index([empCode, punchDate])  // fast query
}

model Attendance {
  id               Int       @id @default(autoincrement())
  employeeId       Int
  employee         Employee  @relation(fields: [employeeId], references: [id])
  date             DateTime
  status           String    @default("present")
  scheduledIn      DateTime?
  scheduledOut     DateTime?
  actualIn         DateTime?
  actualOut        DateTime?
  lateMinutes      Int       @default(0)
  overtimeMinutes  Int       @default(0)
  lateDeduction    Float     @default(0)
  overtimeAmount   Float     @default(0)
  netAdjustment    Float     @default(0)
  note             String?
  createdAt        DateTime  @default(now())

  @@unique([employeeId, date])
}

model Gatepass {
  id          Int       @id @default(autoincrement())
  employeeId  Int
  employee    Employee  @relation(fields: [employeeId], references: [id])
  reason      String
  issuedAt    DateTime
  validTill   DateTime?
  status      String    @default("pending")
  createdAt   DateTime  @default(now())
}

model Shortleave {
  id          Int       @id @default(autoincrement())
  employeeId  Int
  employee    Employee  @relation(fields: [employeeId], references: [id])
  fromTime    DateTime
  toTime      DateTime
  reason      String?
  status      String    @default("pending")
  createdAt   DateTime  @default(now())
}

model AdvanceLoan {
  id          Int       @id @default(autoincrement())
  employeeId  Int
  employee    Employee  @relation(fields: [employeeId], references: [id])
  amount      Float
  type        String    @default("advance") // 'advance' or 'loan'
  reason      String?
  status      String    @default("pending")
  createdAt   DateTime  @default(now())
}

model InventoryCategory {
  id            Int                    @id @default(autoincrement())
  code          String                 @unique
  name          String
  status        String                 @default("active")
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  subcategories InventorySubcategory[]
  items         InventoryItem[]
  purchaseOrders InventoryPurchaseOrder[]
  grns          InventoryGRN[]

  @@unique([name])
  @@index([status])
}

model InventorySubcategory {
  id          Int               @id @default(autoincrement())
  code        String            @unique
  name        String
  status      String            @default("active")
  categoryId  Int
  category    InventoryCategory @relation(fields: [categoryId], references: [id])
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  items       InventoryItem[]
  purchaseOrders InventoryPurchaseOrder[]
  grns        InventoryGRN[]
  payeeHeads  AccPayeeHead[]

  @@unique([categoryId, name])
  @@index([status])
}

model InventorySupplier {
  id             Int             @id @default(autoincrement())
  code           String          @unique
  name           String
  address        String?
  contactDetails String?
  bankingDetails String?
  status         String          @default("active")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  items          InventoryItem[]
  purchaseOrders InventoryPurchaseOrder[]
  grns           InventoryGRN[]
  maintenances   InventoryMaintenance[]

  @@unique([name])
  @@index([status])
}

model InventoryStorage {
  id               Int             @id @default(autoincrement())
  code             String          @unique
  name             String
  numberAllotment  String?
  status           String          @default("active")
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  items            InventoryItem[]

  @@unique([name])
  @@index([status])
}

model InventoryItem {
  id             Int                   @id @default(autoincrement())
  code           String                @unique
  name           String
  itemType       String
  unit           String
  purchasePrice  Float
  lastGrnRate    Float?
  hasExpiry      Boolean               @default(false)
  reorderLevel   Float                 @default(0)
  currentStock   Float                 @default(0)
  status         String                @default("active")

  brand          String?
  model          String?
  serialNumber   String?
  assetLocation  String?
  purchaseDate   DateTime?
  warrantyUntil  DateTime?
  usefulLifeYears Int?
  usefulLifeUnit  String?
  assetCondition String?               @default("working")
  bookValue      Float?
  comment        String?

  categoryId     Int
  category       InventoryCategory     @relation(fields: [categoryId], references: [id])
  subcategoryId  Int
  subcategory    InventorySubcategory  @relation(fields: [subcategoryId], references: [id])
  supplierId     Int?
  supplier       InventorySupplier?    @relation(fields: [supplierId], references: [id])
  storageId      Int?
  storage        InventoryStorage?     @relation(fields: [storageId], references: [id])

  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  stockMovements InventoryStockMovement[]
  reorderAlerts  InventoryReorderAlert[]
  purchaseOrders InventoryPurchaseOrder[]
  grns           InventoryGRN[]
  assetInstances AssetInstance[]
  gds            InventoryGD[]
  gins           InventoryGIN[]
  ginItems       InventoryGINItem[]
  salesInvoices  InventorySalesInvoice[]
  gdns           InventoryGDN[]
  maintenances   InventoryMaintenance[]
  mrnItems       InventoryMRNItem[]

  @@index([status])
  @@index([name])
  @@index([assetCondition])
}

model InventoryStockMovement {
  id            Int            @id @default(autoincrement())
  itemId        Int
  item          InventoryItem  @relation(fields: [itemId], references: [id])
  movementType  String
  quantity      Float
  unitRate      Float?
  previousStock Float
  newStock      Float
  referenceType String?
  referenceId   String?
  expiryDate    DateTime?
  note          String?
  createdAt     DateTime       @default(now())

  @@index([itemId, createdAt])
  @@index([movementType])
  @@index([referenceType])
}

model InventoryReorderAlert {
  id           Int            @id @default(autoincrement())
  itemId        Int
  item          InventoryItem  @relation(fields: [itemId], references: [id])
  thresholdQty  Float
  currentQty    Float
  status        String         @default("open")
  message       String
  createdAt     DateTime       @default(now())
  resolvedAt    DateTime?

  @@index([itemId, status])
}

model InventoryDepartment {
  id        Int           @id @default(autoincrement())
  code      String        @unique
  name      String        @unique
  status    String        @default("active")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  gds       InventoryGD[]
  gins      InventoryGIN[]
  gdHeaders InventoryGDHeader[]
  mrns      InventoryMRN[]

  @@index([status])
}

model InventoryDemandCategoryType {
  id        Int           @id @default(autoincrement())
  code      String        @unique
  name      String        @unique
  status    String        @default("active")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  gds       InventoryGD[]

  @@index([status])
}

model InventoryPurchaseOrder {
  id                    Int                  @id @default(autoincrement())
  code                  String               @unique
  supplierId            Int
  supplier              InventorySupplier    @relation(fields: [supplierId], references: [id])
  itemId                Int
  item                  InventoryItem        @relation(fields: [itemId], references: [id])
  categoryId            Int
  category              InventoryCategory    @relation(fields: [categoryId], references: [id])
  subcategoryId         Int
  subcategory           InventorySubcategory @relation(fields: [subcategoryId], references: [id])
  inHandQuantity        Float                @default(0)
  requiredQuantity      Float
  orderedRate           Float?
  expectedDate          DateTime
  poDate                DateTime             @default(now())
  lastPurchaseDate      DateTime?
  lastPurchaseSupplier  String?
  lastPurchaseRate      Float?
  lastPurchaseQuantity  Float?
  status                String               @default("open")
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  grn                   InventoryGRN?

  @@index([supplierId])
  @@index([itemId])
  @@index([status])
}

model InventoryGRN {
  id               Int                  @id @default(autoincrement())
  code             String               @unique
  poId             Int                  @unique
  purchaseOrder    InventoryPurchaseOrder @relation(fields: [poId], references: [id])
  supplierId       Int
  supplier         InventorySupplier    @relation(fields: [supplierId], references: [id])
  itemId           Int
  item             InventoryItem        @relation(fields: [itemId], references: [id])
  categoryId       Int
  category         InventoryCategory    @relation(fields: [categoryId], references: [id])
  subcategoryId    Int
  subcategory      InventorySubcategory @relation(fields: [subcategoryId], references: [id])
  orderedQuantity  Float
  orderedRate      Float
  receivedQuantity Float
  receivedRate     Float
  retailPrice      Float?
  totalAmount      Float
  receivedDate     DateTime
  billDate         DateTime?
  paymentType      String               @default("cash")
  paymentNote      String?
  isPaid           Boolean              @default(false)
  manufacturer     String?
  model            String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  assetInstances AssetInstance[]

  @@index([receivedDate])
  @@index([supplierId])
  @@index([categoryId, subcategoryId])
}

model EmployeeSalaryPayment {
  id          Int      @id @default(autoincrement())
  empCode     String
  salaryMonth String
  salaryYear  String
  voucherNo   String
  paidAt      DateTime @default(now())

  @@unique([empCode, salaryMonth, salaryYear])
}

model InventoryGD {
  id                    Int                        @id @default(autoincrement())
  code                  String                     @unique
  itemId                Int
  item                  InventoryItem              @relation(fields: [itemId], references: [id])
  departmentId          Int
  department            InventoryDepartment        @relation(fields: [departmentId], references: [id])
  demandCategoryTypeId  Int
  demandCategoryType    InventoryDemandCategoryType @relation(fields: [demandCategoryTypeId], references: [id])
  quantityRequested     Float
  requestDate           DateTime
  status                String                     @default("open")
  location              String?
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt

  gdHeaderId            Int?
  gdHeader              InventoryGDHeader?         @relation(fields: [gdHeaderId], references: [id])

  gins                  InventoryGIN[]
  ginItems              InventoryGINItem[]

  @@index([requestDate])
  @@index([departmentId])
  @@index([status])
  @@index([gdHeaderId])
}

model InventoryGIN {
  id              Int                  @id @default(autoincrement())
  code            String               @unique
  gdId            Int?
  gd              InventoryGD?         @relation(fields: [gdId], references: [id])
  gdHeaderId      Int?
  gdHeader        InventoryGDHeader?   @relation(fields: [gdHeaderId], references: [id])
  itemId          Int?
  item            InventoryItem?       @relation(fields: [itemId], references: [id])
  departmentId    Int
  department      InventoryDepartment  @relation(fields: [departmentId], references: [id])
  issuedById      Int?
  issuedBy        Employee?            @relation(fields: [issuedById], references: [id])
  issuedQuantity  Float?
  issueDate       DateTime
  admissionNumber String?
  status          String               @default("issued")
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  ginItems       InventoryGINItem[]
  mrns           InventoryMRN[]

  @@index([issueDate])
  @@index([departmentId])
  @@index([gdHeaderId])
}

model InventoryGDHeader {
  id              Int                 @id @default(autoincrement())
  code            String              @unique
  departmentId    Int
  department      InventoryDepartment @relation(fields: [departmentId], references: [id])
  status          String              @default("open")
  requestDate     DateTime
  admissionNumber String?
  comment         String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  gdItems       InventoryGD[]
  gins          InventoryGIN[]
  notifications GdNotification[]

  @@index([requestDate])
  @@index([departmentId])
  @@index([status])
}

model GdNotification {
  id          Int               @id @default(autoincrement())
  gdHeaderId  Int
  gdHeader    InventoryGDHeader @relation(fields: [gdHeaderId], references: [id])
  isRead      Boolean           @default(false)
  createdAt   DateTime          @default(now())

  @@index([isRead])
  @@index([gdHeaderId])
}

model InventoryGINItem {
  id             Int           @id @default(autoincrement())
  ginId          Int
  gin            InventoryGIN  @relation(fields: [ginId], references: [id])
  gdItemId       Int?
  gdItem         InventoryGD?  @relation(fields: [gdItemId], references: [id])
  itemId         Int
  item           InventoryItem @relation(fields: [itemId], references: [id])
  issuedQuantity Float
  createdAt      DateTime      @default(now())

  @@index([ginId])
  @@index([itemId])
}

model InventorySalesInvoiceHeader {
  id              Int                      @id @default(autoincrement())
  code            String                   @unique
  invoiceDate     DateTime                 @default(now())
  customerType    String
  customerName    String?
  subTotal        Float                    @default(0)
  discountPercent Float                    @default(0)
  discountAmount  Float                    @default(0)
  totalAmount     Float                    @default(0)
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  items        InventorySalesInvoice[]

  @@index([invoiceDate])
  @@index([customerType])
}

model InventorySalesInvoice {
  id              Int                            @id @default(autoincrement())
  code            String                         @unique
  headerId        Int?
  header          InventorySalesInvoiceHeader?   @relation(fields: [headerId], references: [id])
  itemId          Int
  item            InventoryItem                  @relation(fields: [itemId], references: [id])
  invoiceDate     DateTime                       @default(now())
  customerType    String
  customerName    String?
  quantity        Float
  purchasePrice   Float
  retailPrice     Float
  markupPercent   Float                          @default(0)
  saleRate        Float
  totalAmount     Float
  createdAt       DateTime                       @default(now())
  updatedAt       DateTime                       @updatedAt

  @@index([invoiceDate])
  @@index([itemId])
  @@index([customerType])
  @@index([headerId])
}

model InventoryGDN {
  id              Int                   @id @default(autoincrement())
  code            String                @unique
  itemId          Int
  item            InventoryItem         @relation(fields: [itemId], references: [id])
  quantity        Float
  reason          String
  scrapValue      Float?
  discardedDate   DateTime              @default(now())
  maintenanceId   Int?
  maintenance     InventoryMaintenance? @relation(fields: [maintenanceId], references: [id])
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([discardedDate])
  @@index([itemId])
  @@index([maintenanceId])
}

model InventoryMaintenance {
  id             Int               @id @default(autoincrement())
  moNumber       String?           @unique
  itemId         Int
  item           InventoryItem     @relation(fields: [itemId], references: [id])
  supplierId     Int
  supplier       InventorySupplier @relation(fields: [supplierId], references: [id])
  employeeId     Int?
  employee       Employee?         @relation(fields: [employeeId], references: [id])
  natureOfRepair String
  cost           Float?
  actualCost     Float?
  date           DateTime
  status         String            @default("in_repair")
  receivedDate   DateTime?
  checkedBy      String?
  warrantyDays   Int?
  printedBy      String?
  generatedAt    DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  assetInstances AssetInstance[]
  gdns           InventoryGDN[]

  @@index([itemId])
  @@index([supplierId])
  @@index([employeeId])
  @@index([date])
  @@index([status])
}

model AssetInstance {
  id            Int                   @id @default(autoincrement())
  assetTag      String                @unique
  itemId        Int
  item          InventoryItem         @relation(fields: [itemId], references: [id])
  grnId         Int?
  grn           InventoryGRN?         @relation(fields: [grnId], references: [id])
  maintenanceId Int?
  maintenance   InventoryMaintenance? @relation(fields: [maintenanceId], references: [id])
  condition     String                @default("working")
  location      String?
  serialNumber  String?
  notes         String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@index([itemId])
  @@index([condition])
}

// ─── Clinic Module ────────────────────────────────────────────────────────────

model ClinicDepartment {
  id          Int                   @id @default(autoincrement())
  code        String                @default("")
  name        String                @unique
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  subDepartments ClinicSubDepartment[]
  billHeads      ClinicBillHead[]
}

model ClinicSubDepartment {
  id           Int                   @id @default(autoincrement())
  code         String                @default("")
  name         String
  departmentId Int
  department   ClinicDepartment      @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  doctorSubDepts  ClinicDoctorSubDept[]
  opdVisitDoctors ClinicOpdVisitDoctor[]
  panelRates      ClinicPanelSubDeptRate[]
  empSubDeptRates ClinicPanelEmpSubDeptRate[]

  @@unique([departmentId, name])
  @@index([departmentId])
}

model ClinicSurgeryType {
  id        Int      @id @default(autoincrement())
  code      String   @unique @default("")
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ClinicSymptom {
  id        Int      @id @default(autoincrement())
  code      String   @unique @default("")
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ClinicDisease {
  id        Int      @id @default(autoincrement())
  code      String   @unique @default("")
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ClinicDocumentType {
  id        Int      @id @default(autoincrement())
  code      String   @unique @default("")
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ClinicDischargeType {
  id        Int      @id @default(autoincrement())
  code      String   @unique @default("")
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Shift (Parameters) — timing configured by the admin; every transaction
// records which shift & which logged-in user created it, so shift/user-wise
// reports never need extra plumbing later. ───────────────────────────────────
model ClinicShift {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  fromTime  String
  toTime    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Provisional Bill (manual Ward/Heads line items per admission) ───────────
model ClinicProvisionalBillItem {
  id             Int             @id @default(autoincrement())
  admissionId    Int
  admission      ClinicAdmission @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  roomCategoryId Int?
  billHeadId     Int?
  qty            Int             @default(1)
  rate           Float           @default(0)
  amount         Float           @default(0)
  remarks        String?
  patientType    String?
  sourceOpdVisitId Int?
  serialNo       String?
  createdAt      DateTime        @default(now())

  @@index([admissionId])
}

// ─── Provisional Bill > Pharmacy — Outside Hospital Store ────────────────────
// A small, hospital-managed list of external pharmacy names (distinct from the
// in-house store, which is derived live from Inventory Sales Invoices — no
// table needed for that side). Medicines bought from outside the hospital are
// entered manually against one of these stores.
model ClinicPharmacyStore {
  id        Int      @id @default(autoincrement())
  name      String
  status    String   @default("active") // active | inactive
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items ClinicProvisionalPharmacyItem[]
}

model ClinicProvisionalPharmacyItem {
  id          Int                  @id @default(autoincrement())
  admissionId Int
  admission   ClinicAdmission      @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  storeId     Int?
  store       ClinicPharmacyStore? @relation(fields: [storeId], references: [id])
  medicine    String
  dosage      String?
  qty         Float                @default(1)
  unit        String?
  rate        Float                @default(0)
  amount      Float                @default(0)
  medDate     DateTime
  remarks     String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([admissionId])
}

// ─── Upload Patient Document ──────────────────────────────────────────────────
model ClinicPatientDocument {
  id             Int              @id @default(autoincrement())
  admissionId    Int
  admission      ClinicAdmission  @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  documentTypeId Int?
  fileName       String
  filePath       String
  mimeType       String?
  fileSize       Int?
  uploadedBy     String?
  uploadedAt     DateTime         @default(now())

  @@index([admissionId])
}

model ClinicStaffCategory {
  id        Int            @id @default(autoincrement())
  name      String         @unique
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  doctors        ClinicDoctor[]
  billHeadCats   ClinicBillHeadStaffCat[]
  payeeHeadLinks AccPayeeHeadStaffCategory[]
}

model ClinicDoctor {
  id              Int                   @id @default(autoincrement())
  code            String                @unique
  name            String
  speciality      String?
  qualification   String?
  staffCategoryId Int?
  staffCategory   ClinicStaffCategory?  @relation(fields: [staffCategoryId], references: [id])
  status          String                @default("active")
  consultantDays  String[]
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  subDepts        ClinicDoctorSubDept[]
  opdVisitDoctors ClinicOpdVisitDoctor[]
}

model ClinicDoctorSubDept {
  id             Int                 @id @default(autoincrement())
  doctorId       Int
  doctor         ClinicDoctor        @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  subDeptId      Int
  subDept        ClinicSubDepartment @relation(fields: [subDeptId], references: [id])
  fromTime       String?
  toTime         String?
  normalCharges  Float               @default(0)
  oddCharges     Float               @default(0)
  paymentType    String              @default("amount")
  normalFees     Float               @default(0)
  oddFees        Float               @default(0)
  onCall         Boolean             @default(false)
  consultantDays String[]
  // Miscellaneous-only: lets an item be priced/quantified at slip-creation
  // time instead of using a fixed normalCharges value.
  priceEditable    Boolean           @default(false)
  quantityEditable Boolean           @default(false)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([doctorId])
  @@index([subDeptId])
}

// ─── Credit Card Surcharge Parameter ──────────────────────────────────────────
// Single-row config: if a CC-paid slip's amount >= minAmount, percentage is
// added as a surcharge (see ccPercentage/ccMinAmount/ccCharge on ClinicOpdVisit).
model ClinicCreditCardConfig {
  id         Int      @id @default(autoincrement())
  percentage Float    @default(0)
  minAmount  Float    @default(0)
  updatedAt  DateTime @updatedAt
}

// ─── Clinic OPD ───────────────────────────────────────────────────────────────

model ClinicOpdVisit {
  id            Int                    @id @default(autoincrement())
  serialNo      String                 @unique
  mrNo          Int?
  patientType   String                 @default("MAST")
  patientName   String                 @default("")
  admitPatient  Boolean                @default(false)
  admitNo       String?
  adjustPayment Boolean                @default(false)
  antenatal     Boolean                @default(false)
  antenatalNo   String?
  age           Int?
  ageMonths     Int                    @default(0)
  ageDays       Int                    @default(0)
  gender        String                 @default("male")
  phoneNo       String?
  referredBy    String?
  driver        String?
  location      String?
  hospitalPatient Boolean              @default(true)
  advisedBy     String?
  createdByUserId String?
  createdByName   String?
  shiftId         Int?
  shiftName       String?
  paymentType   String                 @default("cash")
  visitType     String                 @default("opd")
  onCall        Boolean                @default(false)
  employeeId      Int?
  employeeName    String?
  totalAmount     Float                  @default(0)
  discount        Float                  @default(0)
  receive         Float                  @default(0)
  refund          Float                  @default(0)
  panelCompanyId  Int?
  panelEmployeeId Int?
  panelDependentId Int?
  department      String                 @default("General OPD")
  // Credit Card surcharge — snapshot of the configured percentage/min-amount
  // (from ClinicCreditCardConfig) at slip-creation time plus the amount it
  // actually added, so reprints stay accurate even if the config changes later.
  ccPercentage    Float                  @default(0)
  ccMinAmount     Float                  @default(0)
  ccCharge        Float                  @default(0)
  printCount      Int                    @default(0)
  status          String                 @default("active")
  cancelReason    String?
  cancelNote      String?
  cancelledAt     DateTime?
  cancelledBy     String?
  refundReason    String?
  refundNote      String?
  refundedAt      DateTime?
  refundedBy      String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  doctors         ClinicOpdVisitDoctor[]

  @@index([createdAt])
}

model ClinicOpdVisitDoctor {
  id          Int                 @id @default(autoincrement())
  visitId     Int
  visit       ClinicOpdVisit      @relation(fields: [visitId], references: [id], onDelete: Cascade)
  doctorId    Int
  doctor      ClinicDoctor        @relation(fields: [doctorId], references: [id])
  subDeptId   Int
  subDept     ClinicSubDepartment @relation(fields: [subDeptId], references: [id])
  amount      Float               @default(0)
  extAmount   Float               @default(0)
  quantity    Int                 @default(1)
  createdAt   DateTime            @default(now())
}

// ─── Clinic Room & Bed ────────────────────────────────────────────────────────

model ClinicRoomCategory {
  id        Int         @id @default(autoincrement())
  code      String      @unique @default("")
  name      String      @unique
  rate      Float       @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  beds              ClinicBed[]
  billHeadWards     ClinicBillHeadWard[]
  panelEntitlements ClinicPanelRoomEntitlement[]
  empRoomEntitlements ClinicPanelEmpRoomEntitlement[]
}

model ClinicBed {
  id             Int                @id @default(autoincrement())
  name           String
  roomCategoryId Int
  roomCategory   ClinicRoomCategory @relation(fields: [roomCategoryId], references: [id], onDelete: Cascade)
  status         String             @default("available")
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([roomCategoryId, name])
  @@index([roomCategoryId])
}

// ─── Bed Shifting (history of bed transfers for an admission) ────────────────
model ClinicBedShiftHistory {
  id          Int      @id @default(autoincrement())
  admissionId Int
  fromBedId   Int?
  toBedId     Int
  shiftedBy   String?
  shiftedAt   DateTime @default(now())

  @@index([admissionId])
}

// ─── Clinic Admission ─────────────────────────────────────────────────────────

model ClinicAdmission {
  id                 Int      @id @default(autoincrement())
  serialNo           String?  @unique
  admissionNo        String
  mrNo               Int?
  arrivedSlipNo      String?
  patientTitle       String   @default("Mr")
  patientCategory    String   @default("private")
  patientName        String   @default("")
  relationType       String?
  relationName       String?
  ageYears           Int      @default(0)
  ageMonths          Int      @default(0)
  ageDays            Int      @default(0)
  gender             String   @default("male")
  address            String?
  phoneNo            String?
  arrivedUnderRmo    String?
  consultantId       Int?
  referredBy         String?
  authorityLetter    Boolean  @default(false)
  responsibleParty   String?
  previousAdmission  String?
  advancePayment     Decimal? @db.Decimal(10, 2)
  roomCategoryId     Int?
  bedId              Int?
  surgery            Boolean  @default(false)
  surgeryTypeId      Int?
  dischargeTypeId    Int?
  referralPatient    Boolean  @default(false)
  referralNote       String?
  antenatal          Boolean  @default(false)
  antenatalNo        String?
  dischargeDiscount  Float?
  // Panel Company/Employee selected via the same Panel picker OPD slips use
  // (patientCategory 'panel') — plain soft-linked ids, no @relation, matching
  // ClinicOpdVisit's identical fields (never enforced as an FK there either).
  panelCompanyId     Int?
  panelEmployeeId    Int?
  panelDependentId   Int?
  status             String   @default("active")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  payments           ClinicAdmissionPayment[]
  documents          ClinicPatientDocument[]
  provisionalBillItems ClinicProvisionalBillItem[]
  provisionalPharmacyItems ClinicProvisionalPharmacyItem[]
  dischargeBillItems ClinicDischargeBillItem[]
  discountRefunds    ClinicAdmissionDiscountRefund[]
  dischargeCertificate ClinicDischargeCertificate?
  wardHistoryRateOverrides ClinicWardHistoryRateOverride[]
  otRegisters        ClinicOtRegister[]
  birthCertificates  ClinicBirthCertificate[]
  panelBillingItems  ClinicPanelBillingItem[]
  panelBillingHeader ClinicPanelBillingHeader?
}

// Panels > Transaction > Billing — a per-admission, independently-editable
// snapshot of the Provisional Bill rows (see getPanelAdmissionBilling). Seeded
// once from the live Provisional Bill the first time Billing is opened for an
// admission; every Rate/Qty/Remarks edit after that lives here only — the
// original Provisional Bill (billItems/Ward History/Diagnostic/Pharmacy tabs)
// is never touched.
model ClinicPanelBillingItem {
  id          Int             @id @default(autoincrement())
  admissionId Int
  admission   ClinicAdmission @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  billHeadId  Int?
  code        String?
  description String
  kind        String          @default("item") // ward | item | pharmacy | diagnostic | custom
  qty         Float           @default(0)
  rate        Float           @default(0)
  amount      Float           @default(0)
  remarks     String?
  // Must stay within the header's admitDate/dischargeDate — see
  // ClinicPanelBillingHeader and updatePanelBillingItem's validation.
  date        DateTime?
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([admissionId])
}

// Panels > Billing header — its own editable Admit Date/Discharge Date,
// independent of the actual Admission/Discharge Certificate (same snapshot
// principle as ClinicPanelBillingItem). Every row's own Date (above) must
// stay within this range — enforced in updatePanelBillingItem/addPanelBillingItem.
model ClinicPanelBillingHeader {
  admissionId   Int             @id
  admission     ClinicAdmission @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  admitDate     DateTime?
  dischargeDate DateTime?
  updatedAt     DateTime        @updatedAt
}

// Panels > Parameter > Bill Head — a bill-head list independent of the main
// Clinic Bill Heads (ClinicBillHead), only ever offered inside Panel Billing's
// manual-add flow. Two kinds: 'simple' (just a name, Qty/Rate entered freely
// when added to a bill — same as any other manual-add) and 'package' (a named
// bundle, e.g. "Surgery", holding its own list of medicines+rates below —
// adding a package head to a bill opens a checklist so only the medicines that
// actually applied for that patient get added, each as its own bill row).
model ClinicPanelBillHead {
  id          Int      @id @default(autoincrement())
  headCode    String   @unique
  description String
  kind        String   @default("simple") // simple | package
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  packageItems ClinicPanelBillHeadItem[]
}

model ClinicPanelBillHeadItem {
  id        Int                 @id @default(autoincrement())
  headId    Int
  head      ClinicPanelBillHead @relation(fields: [headId], references: [id], onDelete: Cascade)
  medicine  String
  rate      Float               @default(0)
  sortOrder Int                 @default(0)
  createdAt DateTime            @default(now())

  @@index([headId])
}

// ─── Birth Certificate ────────────────────────────────────────────────────────
// One admission can have multiple births (twins etc.) — sequenceNo picks
// which one. Mother Name/Father Name/Address default from the admission's own
// Patient Name / relationName (when relationType is "W/o") / Address, but stay
// freely editable per certificate.
// ─── Appointment ───────────────────────────────────────────────────────────────
// Looked up by Slip # (an OPD visit's serialNo) — Antenatal #/Consultant are
// snapshotted from that visit at save time, purely informational; the only
// thing actually being captured here is Next Appointment Date + Phone No.
model ClinicAppointment {
  id                  Int       @id @default(autoincrement())
  slipNo              String
  opdVisitId          Int?
  patientName         String    @default("")
  antenatalNo         String?
  consultantName      String?
  nextAppointmentDate DateTime?
  phoneNo             String?
  createdByUserId     String?
  createdByName       String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([slipNo])
}

model ClinicBirthCertificate {
  id              Int             @id @default(autoincrement())
  // Optional link — bulk Excel imports of historical births often reference
  // an Admission # that predates this system and has no ClinicAdmission row.
  // admissionNo is always stored directly either way (see ClinicOtRegister
  // for the same pattern), so the report never depends on the link existing.
  admissionId     Int?
  admission       ClinicAdmission? @relation(fields: [admissionId], references: [id], onDelete: SetNull)
  admissionNo     String
  sequenceNo      Int             @default(1)
  motherName      String          @default("")
  fatherName      String?
  address         String?
  bloodGroup      String?
  birthTime       DateTime?
  weight          Float?
  gender          String?
  remarks         String?
  createdByUserId String?
  createdByName   String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@unique([admissionId, sequenceNo])
  @@index([admissionId])
  @@index([admissionNo])
}

// ─── OT Register ──────────────────────────────────────────────────────────────
// Anaesthesiologist/Surgeon/Tech are just ClinicDoctor rows whose staffCategory
// matches that role (e.g. a "Surgeon" staff category assigned in Doctor
// parameters) — no dedicated relation here, doctor ids are plain FKs and the
// frontend resolves names/roles from the already-loaded doctors list.
model ClinicOtRegister {
  id                      Int             @id @default(autoincrement())
  // Optional link — bulk Excel imports of historical OT data often reference
  // an Admission # that predates this system and has no ClinicAdmission row.
  // admissionNo/patientName/patientCategory are always stored directly (copied
  // from the real admission when one is found, or straight from the Excel row
  // when not) so the report never depends on the link existing.
  admissionId             Int?
  admission               ClinicAdmission? @relation(fields: [admissionId], references: [id], onDelete: SetNull)
  admissionNo             String
  patientName             String          @default("")
  patientCategory         String          @default("private")
  surgeryDateTime         DateTime
  anaesthesiologistId     Int?
  anaesthesiologistOnCall Boolean         @default(false)
  surgeon1Id              Int?
  surgeon1OnCall          Boolean         @default(false)
  surgeon2Id              Int?
  surgeon2OnCall          Boolean         @default(false)
  tech1Id                 Int?
  tech1OnCall             Boolean         @default(false)
  tech2Id                 Int?
  tech2OnCall             Boolean         @default(false)
  surgeryTypeId           Int?
  useBlood                Boolean         @default(false)
  bloodType               String?
  bloodQty                Float?
  createdByUserId         String?
  createdByName           String?
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  @@index([admissionId])
  @@index([admissionNo])
}

// ─── Discount & Refund Against Admission (mid-admission, before discharge) ───
// Bill Amount / Received Amount are snapshots pulled from the Provisional
// Bill and admission payments at save time — discountAmount can be entered
// as a flat Rupee value or a percentage of billAmount (discountType).
// refundAmount = whatever was already received beyond the discounted balance.
model ClinicAdmissionDiscountRefund {
  id              Int             @id @default(autoincrement())
  admissionId     Int
  admission       ClinicAdmission @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  billAmount      Float           @default(0)
  receivedAmount  Float           @default(0)
  discountAmount  Float           @default(0)
  discountType    String          @default("amount")
  permissionBy    String?
  netBalance      Float           @default(0)
  refundAmount    Float           @default(0)
  createdByUserId String?
  createdByName   String?
  createdAt       DateTime        @default(now())

  @@index([admissionId])
}

// ─── Discharge Certificate ────────────────────────────────────────────────────
// One per admission — surfaced on Discount & Refund Against Admission once its
// balance hits zero. Upserted (not append-only like DiscountRefund above) so
// the same certificate can be edited/reprinted rather than piling up rows.
model ClinicDischargeCertificate {
  id                     Int             @id @default(autoincrement())
  admissionId            Int             @unique
  admission              ClinicAdmission @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  diagnosis              String?
  reasonOfDischarge      String          // treated | transfer | lama | expired | discharge_on_request
  furtherTreatmentNeeded String?         // yes | no
  medicinePrescribed     String?         // yes | no
  dischargeMedicine      String?
  followUp               String?
  medicalOfficer         String?
  dischargeDate          DateTime        @default(now())
  createdByUserId        String?
  createdByName          String?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
}

// ─── Ward History rate override (Provisional Bill) ────────────────────────────
// Ward History itself has no table — it's derived on read from
// ClinicBedShiftHistory + ClinicAdmission + ClinicRoomCategory.rate (see
// computeWardHistory). A segment is uniquely identified by (admissionId,
// enteredAt) since two segments on the same admission can never start at the
// exact same instant — this table only overrides that one segment's rate
// when staff edits it manually, everything else about the segment stays derived.
model ClinicWardHistoryRateOverride {
  id          Int             @id @default(autoincrement())
  admissionId Int
  admission   ClinicAdmission @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  enteredAt   DateTime
  rate        Float
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([admissionId, enteredAt])
}

// ─── Discharge and Refund (final bill at time of discharge) ──────────────────
// A row here is either added manually on this page (source="manual"), or
// snapshot-copied in once from that admission's Provisional Bill the first
// time this page opens it (source="provisional"/"ward"/"diagnostic"/
// "pharmacy" — matching Provisional Bill's own Bill Heads / Ward History /
// collapsed Diagnostic-per-department / summed Pharmacy). It's a one-time
// copy, not a live link — editing/deleting here never touches the
// Provisional Bill's own records.
model ClinicDischargeBillItem {
  id             Int             @id @default(autoincrement())
  admissionId    Int
  admission      ClinicAdmission @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  billHeadId     Int?
  doctorId       Int?
  // Only set for a Bill Head that has a refDepartmentId (Const Fee/
  // Laboratory/Ultrasound/X-Ray) — identifies which of that doctor's
  // ClinicDoctorSubDept rows priced this row, so Doctor Fee / Hospital Share
  // can be split from Amount using that pairing's Normal Fees.
  subDeptId      Int?
  doctorFee      Float?
  hospitalShare  Float?
  // A Const Fee row's doctorFee gets paid out to the consultant via Voucher
  // Expense (IPD Consultant Fee payee type) — once picked into a payment
  // there, this flips true so it stops showing up as still-owed.
  isPaid         Boolean         @default(false)
  description    String?
  qty            Float           @default(1)
  rate           Float           @default(0)
  amount         Float           @default(0)
  source         String          @default("manual") // manual | provisional | ward | diagnostic | pharmacy
  createdAt      DateTime        @default(now())

  consultantFeePayments AccVoucherExpenseEntryConsultantFee[]

  @@index([admissionId])
}

// ─── Admission Status Change > Wipeout Log ───────────────────────────────────
// Wipeout deletes the ClinicAdmission row entirely (and its payments, via
// cascade) — this table keeps a full snapshot + reason so the "Admission
// Status Change Report" can still show what was removed.
model ClinicAdmissionWipeoutLog {
  id                 Int      @id @default(autoincrement())
  admissionNo        String
  serialNo           String?
  mrNo               Int?
  arrivedSlipNo      String?
  patientTitle       String?
  patientCategory    String?
  patientName        String?
  ageYears           Int?
  ageMonths          Int?
  ageDays            Int?
  gender             String?
  address            String?
  phoneNo            String?
  arrivedUnderRmo    String?
  consultantId       Int?
  referredBy         String?
  authorityLetter    Boolean?
  responsibleParty   String?
  previousAdmission  String?
  advancePayment     Decimal? @db.Decimal(10, 2)
  roomCategoryId     Int?
  bedId              Int?
  surgery            Boolean?
  surgeryTypeId      Int?
  referralPatient    Boolean?
  referralNote       String?
  antenatal          Boolean?
  antenatalNo        String?
  admittedAt         DateTime?
  reason             String
  wipedOutBy         String?
  wipedOutAt         DateTime @default(now())
}

// Every non-wipeout File Status change (Admit/Discharge/Closed, in any
// direction) — wipeout stays its own separate log/report (above) since it
// deletes the admission outright; this one is for admissions that still
// exist, just moved between statuses. No FK to ClinicAdmission on purpose:
// admissionNo/patientName are snapshotted directly so this row keeps making
// sense even if the admission is later wiped out.
model ClinicAdmissionStatusLog {
  id          Int      @id @default(autoincrement())
  admissionId Int?
  admissionNo String
  patientName String
  fromStatus  String
  toStatus    String
  reason      String
  changedBy   String?
  changedAt   DateTime @default(now())

  @@index([admissionId])
}

// ─── Receiving against Admission (payment history, one row per receipt) ──────
model ClinicAdmissionPayment {
  id          Int             @id @default(autoincrement())
  serialNo    String          @unique
  admissionId Int
  admission   ClinicAdmission @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  amount      Float
  paymentType String          @default("cash")
  receivedAt  DateTime        @default(now())
  printCount  Int             @default(0)
  createdAt   DateTime        @default(now())

  @@index([admissionId])
}

// ─── Clinic Bill Head ─────────────────────────────────────────────────────────

model ClinicBillHead {
  id                    Int                      @id @default(autoincrement())
  headCode              String                   @unique
  accountReceivable     String?
  description           String                   @default("")
  type                  String                   @default("both")
  refDepartmentId       Int?
  refDepartment         ClinicDepartment?        @relation(fields: [refDepartmentId], references: [id])
  staffCategoryRequired Boolean                  @default(false)
  discountApply         Boolean                  @default(false)
  discountSeq           Int                      @default(0)
  status                String                   @default("active")
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  wardRates          ClinicBillHeadWard[]
  staffCategories    ClinicBillHeadStaffCat[]
  panelRates         ClinicPanelAdmissionRate[]
  empAdmissionRates  ClinicPanelEmpAdmissionRate[]
}

model ClinicBillHeadWard {
  id             Int                @id @default(autoincrement())
  billHeadId     Int
  billHead       ClinicBillHead     @relation(fields: [billHeadId], references: [id], onDelete: Cascade)
  roomCategoryId Int
  roomCategory   ClinicRoomCategory @relation(fields: [roomCategoryId], references: [id])
  enabled        Boolean            @default(true)
  rate           Float              @default(0)
  unit           String?
  status         String             @default("active")
  payContractor  Boolean            @default(false)
  disSeq         Int                @default(0)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([billHeadId, roomCategoryId])
  @@index([billHeadId])
}

model ClinicBillHeadStaffCat {
  id              Int                 @id @default(autoincrement())
  billHeadId      Int
  billHead        ClinicBillHead      @relation(fields: [billHeadId], references: [id], onDelete: Cascade)
  staffCategoryId Int
  staffCategory   ClinicStaffCategory @relation(fields: [staffCategoryId], references: [id], onDelete: Cascade)

  @@unique([billHeadId, staffCategoryId])
}

// ─── Clinic Panel ─────────────────────────────────────────────────────────────

model ClinicPanelCompany {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String
  billingTo String   @default("same")
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subDeptRates     ClinicPanelSubDeptRate[]
  admissionRates   ClinicPanelAdmissionRate[]
  roomEntitlements ClinicPanelRoomEntitlement[]
  employees        ClinicPanelEmployee[]        @relation("PanelCompanyEmployees")
  billEmployees    ClinicPanelEmployee[]        @relation("BillCompanyEmployees")
}

model ClinicPanelSubDeptRate {
  id             Int                 @id @default(autoincrement())
  panelCompanyId Int
  panelCompany   ClinicPanelCompany  @relation(fields: [panelCompanyId], references: [id], onDelete: Cascade)
  subDeptId      Int
  subDept        ClinicSubDepartment @relation(fields: [subDeptId], references: [id])
  enabled        Boolean             @default(true)
  rate           Float               @default(0)
  status         String              @default("active")

  @@unique([panelCompanyId, subDeptId])
  @@index([panelCompanyId])
}

model ClinicPanelAdmissionRate {
  id             Int                @id @default(autoincrement())
  panelCompanyId Int
  panelCompany   ClinicPanelCompany @relation(fields: [panelCompanyId], references: [id], onDelete: Cascade)
  billHeadId     Int
  billHead       ClinicBillHead     @relation(fields: [billHeadId], references: [id])
  enabled        Boolean            @default(true)
  rate           Float              @default(0)
  status         String             @default("active")

  @@unique([panelCompanyId, billHeadId])
  @@index([panelCompanyId])
}

model ClinicPanelRoomEntitlement {
  id             Int                @id @default(autoincrement())
  panelCompanyId Int
  panelCompany   ClinicPanelCompany @relation(fields: [panelCompanyId], references: [id], onDelete: Cascade)
  roomCategoryId Int
  roomCategory   ClinicRoomCategory @relation(fields: [roomCategoryId], references: [id])
  enabled        Boolean            @default(true)

  @@unique([panelCompanyId, roomCategoryId])
  @@index([panelCompanyId])
}

// ─── Clinic Panel Employees ───────────────────────────────────────────────────

model ClinicPanelEmployee {
  id             Int                @id @default(autoincrement())
  companyId      Int
  company        ClinicPanelCompany @relation("PanelCompanyEmployees", fields: [companyId], references: [id], onDelete: Cascade)
  empCode        String             @unique
  title          String             @default("MR")
  name           String
  dob            DateTime?
  compCardNo     String?
  billCompanyId  Int?
  billCompany    ClinicPanelCompany? @relation("BillCompanyEmployees", fields: [billCompanyId], references: [id])
  gender         String             @default("male")
  insuranceExpOn DateTime?
  entitlement    String             @default("general")
  status         String             @default("active")
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  dependents       ClinicPanelEmployeeDependent[]
  subDeptRates     ClinicPanelEmpSubDeptRate[]
  admissionRates   ClinicPanelEmpAdmissionRate[]
  roomEntitlements ClinicPanelEmpRoomEntitlement[]
}

model ClinicPanelEmployeeDependent {
  id         Int                 @id @default(autoincrement())
  employeeId Int
  employee   ClinicPanelEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  code       String
  title      String              @default("MR")
  name       String
  relation   String
