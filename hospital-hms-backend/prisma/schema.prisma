// ─── Fuel Management ──────────────────────────────────────────────────────────

model FuelVehicle {
  id          Int                @id @default(autoincrement())
  name        String
  plateNo     String?
  type        String             @default("van")
  status      String             @default("active")
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  entries     FuelVehicleEntry[]

  @@index([status])
}

model FuelVehicleEntry {
  id           Int         @id @default(autoincrement())
  vehicleId    Int
  vehicle      FuelVehicle @relation(fields: [vehicleId], references: [id])
  entryType    String      // fuel | oil
  date         DateTime    @default(now())
  driverName   String?
  quantity     Float
  rate         Float
  amount       Float
  lastKm       Float?
  currentKm    Float?
  netRunning   Float?
  avgPerLiter  Float?
  notes        String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([vehicleId, entryType])
  @@index([date])
}

model FuelGenerator {
  id          Int                   @id @default(autoincrement())
  name        String
  modelNo     String?
  serialNo    String?
  location    String?
  status      String                @default("active")
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  entries     FuelGeneratorEntry[]
  dailySheets GeneratorDailySheet[]
  transfersIn FuelTransfer[]

  @@index([status])
}

model FuelGeneratorEntry {
  id           Int            @id @default(autoincrement())
  generatorId  Int?
  generator    FuelGenerator? @relation(fields: [generatorId], references: [id], onDelete: SetNull)
  entryType    String
  date         DateTime       @default(now())
  quantity     Float
  rate         Float
  amount       Float
  lastHours    Float?
  currentHours Float?
  netRunning   Float?
  avgPerHour   Float?
  notes        String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  transfer     FuelTransfer?

  @@index([generatorId, entryType])
  @@index([date])
}

// ─── Fuel Tanks — central fuel is stocked here first, then transferred to a
// specific generator (FuelTransfer). A tank's current level = its stock-in
// minus everything transferred out of it. ─────────────────────────────────────
model FuelTank {
  id           Int            @id @default(autoincrement())
  name         String
  capacity     Float?
  status       String         @default("active")
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  stockEntries FuelStock[]
  transfersOut FuelTransfer[]

  @@index([status])
}

// A single Tank → Generator fuel movement. Also creates a matching
// FuelGeneratorEntry (entryType: 'fuel') so the generator's existing Fuel tab,
// history and L/hr average keep working unchanged — the two rows are linked
// 1:1 via generatorEntryId.
model FuelTransfer {
  id               Int                 @id @default(autoincrement())
  tankId           Int
  tank             FuelTank            @relation(fields: [tankId], references: [id])
  generatorId      Int
  generator        FuelGenerator       @relation(fields: [generatorId], references: [id])
  generatorEntryId Int?                @unique
  generatorEntry   FuelGeneratorEntry? @relation(fields: [generatorEntryId], references: [id])
  quantity         Float
  date             DateTime            @default(now())
  notes            String?
  createdAt        DateTime            @default(now())

  @@index([tankId])
  @@index([generatorId])
  @@index([date])
}

model GeneratorDailySheet {
  id                   Int            @id @default(autoincrement())
  generatorId          Int?
  generator            FuelGenerator? @relation(fields: [generatorId], references: [id], onDelete: SetNull)
  date                 DateTime       @default(now())
  timeStart            String?
  timeClose            String?
  fuelGaugeOn          Float?
  fuelGaugeOff         Float?
  hourlyFuelAssumption Float?
  lastReading          Float?
  currentReading       Float?
  notes                String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@index([generatorId, date])
  @@index([date])
}

model FuelStock {
  id        Int       @id @default(autoincrement())
  tankId    Int?
  tank      FuelTank? @relation(fields: [tankId], references: [id])
  date      DateTime  @default(now())
  quantity  Float
  rate      Float?
  amount    Float?
  supplier  String?
  notes     String?
  createdAt DateTime  @default(now())

  @@index([date])
  @@index([tankId])
}

// ─── Utilities Bill (Electricity) ─────────────────────────────────────────────
// Billing Meters are the ones the electricity company actually bills.
// Department Meters are internal sub-meters under a Billing Meter, tracked
// only for cost allocation — no actual bill / difference on those.
model UtilityMeter {
  id               Int                   @id @default(autoincrement())
  utility          String                @default("electricity") // 'electricity' | 'gas' — separate buckets, same mechanics
  type             String                // 'billing' | 'department' (gas only ever uses 'billing')
  meterNo          String?               // billing meters
  departmentName   String?               // department meters
  billingMeterId   Int?                  // department meters: parent billing meter
  billingMeter     UtilityMeter?         @relation("BillingToDepartment", fields: [billingMeterId], references: [id])
  departmentMeters UtilityMeter[]        @relation("BillingToDepartment")
  location         String?
  status           String                @default("active")
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  readings         UtilityMeterReading[]
  rates            UtilityMeterRate[]
  actualBills      UtilityActualBill[]

  @@index([utility, type, status])
  @@index([billingMeterId])
}

// One row per meter per day — Day and Night shift readings, each with a
// Start/End meter value. dayUnits/nightUnits/totalUnits are computed and
// stored at write time (same pattern as FuelGeneratorEntry.netRunning).
model UtilityMeterReading {
  id         Int          @id @default(autoincrement())
  meterId    Int
  meter      UtilityMeter @relation(fields: [meterId], references: [id])
  date       DateTime
  dayStart   Float?
  dayEnd     Float?
  nightStart Float?
  nightEnd   Float?
  dayUnits   Float?
  nightUnits Float?
  totalUnits Float?
  notes      String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@unique([meterId, date])
  @@index([meterId, date])
}

// Rate history — a new row whenever the per-unit tariff changes, so past
// readings are always costed at the rate that was actually effective then.
model UtilityMeterRate {
  id            Int          @id @default(autoincrement())
  meterId       Int
  meter         UtilityMeter @relation(fields: [meterId], references: [id])
  rate          Float
  effectiveFrom DateTime
  createdAt     DateTime     @default(now())

  @@index([meterId, effectiveFrom])
}

// Actual bill from the electricity company — Billing Meters only, posted per
// monthly cycle (fromDate–toDate) and compared against the estimated cost of
// that same range's readings.
model UtilityActualBill {
  id           Int          @id @default(autoincrement())
  meterId      Int
  meter        UtilityMeter @relation(fields: [meterId], references: [id])
  fromDate     DateTime
  toDate       DateTime
  amount       Float
  unitsCharges Float?
  fixedCharges Float?
  notes        String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([meterId, fromDate])
}

// ─── Material Return Note (MRN) ───────────────────────────────────────────────
// Department ne issued maal wapas kiya — stock increment + movement IN

model InventoryMRN {
  id           Int                 @id @default(autoincrement())
  code         String              @unique
  ginId        Int
  gin          InventoryGIN        @relation(fields: [ginId], references: [id])
  departmentId Int
  department   InventoryDepartment @relation(fields: [departmentId], references: [id])
  returnDate   DateTime
  receivedBy   String?
  notes        String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  mrnItems     InventoryMRNItem[]

  @@index([ginId])
  @@index([departmentId])
  @@index([returnDate])
}

model InventoryMRNItem {
  id          Int           @id @default(autoincrement())
  mrnId       Int
  mrn         InventoryMRN  @relation(fields: [mrnId], references: [id], onDelete: Cascade)
  itemId      Int
  item        InventoryItem @relation(fields: [itemId], references: [id])
  ginItemId   Int?
  returnedQty Float
  createdAt   DateTime      @default(now())

  @@index([mrnId])
  @@index([itemId])
}
