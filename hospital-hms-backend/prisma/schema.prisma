// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String    @id @default(uuid())
  name        String
  email       String    @unique
  password    String
  role        String
  department  String?
  permissions Json      @default("{}")
  isActive     Boolean   @default(true)
  expiresAt    DateTime?
  lastLogin    DateTime?
  lastActivity DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Department {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  employees Employee[]
}

model Employee {
  id                  Int          @id @default(autoincrement())
  empCode             String?      @unique
  firstName           String
  middleName          String?
  lastName            String
  fatherName          String?
  dob                 String?
  gender              String?
  maritalStatus       String?
  spouseName          String?
  nic                 String?
  birthPlace          String?
  beneficiaryName     String?
  beneficiaryRelation String?
  address             String?
  city                String?
  phone               String?
  email               String?      @unique
  reference1          String?
  reference2          String?
  
  departmentId        Int?
  department          Department?  @relation(fields: [departmentId], references: [id])
  departmentText      String?
  role                String?
  status              String?
  appointmentDate     String?
  weeklyHoliday       String?
  workingDays         String?
  disbursement        String?
  salaryMonthly       Float        @default(0)
  allowances          Json?        @default("[]")
  incentive           Float?       @default(0)
  
  dutyType            String?
  dutyRoster          Json?        @default("[]")
  isNightShift        Boolean?     @default(false)
  
  photo               String?      @db.Text
  emergencyContact    String?
  emergencyPhone      String?
  emergencyRelation   String?
  notes               String?

  hasEobi                   Boolean?     @default(false)
  eobiContribution          Float?       @default(0)
  hasSocialSecurity         Boolean?     @default(false)
  socialSecurityContribution Float?      @default(0)
  hasHealthCard             Boolean?     @default(false)
  healthCardContribution    Float?       @default(0)
  hasOtherBenefit           Boolean?     @default(false)
  otherBenefitContribution  Float?       @default(0)
  late                      Float?       @default(0)
  short                     Float?       @default(0)
  qualification             String?

  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  attendances   Attendance[]
  gatepasses    Gatepass[]
  shortleaves   Shortleave[]
  advanceLoans  AdvanceLoan[]
  dependents    EmployeeDependent[]
  issuedGINs    InventoryGIN[]
}

model EmployeeDependent {
  id         Int      @id @default(autoincrement())
  employeeId Int
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  code       String   @default("")
  name       String   @default("")
  relation   String   @default("")
  dob        DateTime?
  gender     String   @default("male")
  status     String   @default("active")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ─── Raw Biometric Punch Logs ─────────────────────────────────────────────────
// Cloud API se aye raw timestamps yahan store hote hain.
// testPairing pehle yahan se padhta hai — cloud se nahi.
model PunchLog {
  id          Int      @id @default(autoincrement())
  empCode     String
  punchTime   DateTime // PKT mein store hoga (UTC+5 converted)
  punchDate   String   // "YYYY-MM-DD" — fast filtering ke liye
  createdAt   DateTime @default(now())

  @@unique([empCode, punchTime]) // duplicate sync se bacho
  @@index([empCode, punchDate])  // fast query
}

model Attendance {
  id               Int       @id @default(autoincrement())
  employeeId       Int
  employee         Employee  @relation(fields: [employeeId], references: [id])
  date             DateTime
  status           String    @default("present")
  scheduledIn      DateTime?
  scheduledOut     DateTime?
  actualIn         DateTime?
  actualOut        DateTime?
  lateMinutes      Int       @default(0)
  overtimeMinutes  Int       @default(0)
  lateDeduction    Float     @default(0)
  overtimeAmount   Float     @default(0)
  netAdjustment    Float     @default(0)
  note             String?
  createdAt        DateTime  @default(now())

  @@unique([employeeId, date])
}

model Gatepass {
  id          Int       @id @default(autoincrement())
  employeeId  Int
  employee    Employee  @relation(fields: [employeeId], references: [id])
  reason      String
  issuedAt    DateTime
  validTill   DateTime?
  status      String    @default("pending")
  createdAt   DateTime  @default(now())
}

model Shortleave {
  id          Int       @id @default(autoincrement())
  employeeId  Int
  employee    Employee  @relation(fields: [employeeId], references: [id])
  fromTime    DateTime
  toTime      DateTime
  reason      String?
  status      String    @default("pending")
  createdAt   DateTime  @default(now())
}

model AdvanceLoan {
  id          Int       @id @default(autoincrement())
  employeeId  Int
  employee    Employee  @relation(fields: [employeeId], references: [id])
  amount      Float
  type        String    @default("advance") // 'advance' or 'loan'
  reason      String?
  status      String    @default("pending")
  createdAt   DateTime  @default(now())
}

model InventoryCategory {
  id            Int                    @id @default(autoincrement())
  code          String                 @unique
  name          String
  status        String                 @default("active")
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  subcategories InventorySubcategory[]
  items         InventoryItem[]
  purchaseOrders InventoryPurchaseOrder[]
  grns          InventoryGRN[]

  @@unique([name])
  @@index([status])
}

model InventorySubcategory {
  id          Int               @id @default(autoincrement())
  code        String            @unique
  name        String
  status      String            @default("active")
  categoryId  Int
  category    InventoryCategory @relation(fields: [categoryId], references: [id])
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  items       InventoryItem[]
  purchaseOrders InventoryPurchaseOrder[]
  grns        InventoryGRN[]

  @@unique([categoryId, name])
  @@index([status])
}

model InventorySupplier {
  id             Int             @id @default(autoincrement())
  code           String          @unique
  name           String
  address        String?
  contactDetails String?
  bankingDetails String?
  status         String          @default("active")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  items          InventoryItem[]
  purchaseOrders InventoryPurchaseOrder[]
  grns           InventoryGRN[]
  maintenances   InventoryMaintenance[]

  @@unique([name])
  @@index([status])
}

model InventoryStorage {
  id               Int             @id @default(autoincrement())
  code             String          @unique
  name             String
  numberAllotment  String?
  status           String          @default("active")
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  items            InventoryItem[]

  @@unique([name])
  @@index([status])
}

model InventoryItem {
  id             Int                   @id @default(autoincrement())
  code           String                @unique
  name           String
  itemType       String
  unit           String
  purchasePrice  Float
  lastGrnRate    Float?
  hasExpiry      Boolean               @default(false)
  reorderLevel   Float                 @default(0)
  currentStock   Float                 @default(0)
  status         String                @default("active")

  brand          String?
  model          String?
  serialNumber   String?
  assetLocation  String?
  purchaseDate   DateTime?
  warrantyUntil  DateTime?
  usefulLifeYears Int?
  usefulLifeUnit  String?
  assetCondition String?               @default("working")
  bookValue      Float?
  comment        String?

  categoryId     Int
  category       InventoryCategory     @relation(fields: [categoryId], references: [id])
  subcategoryId  Int
  subcategory    InventorySubcategory  @relation(fields: [subcategoryId], references: [id])
  supplierId     Int?
  supplier       InventorySupplier?    @relation(fields: [supplierId], references: [id])
  storageId      Int?
  storage        InventoryStorage?     @relation(fields: [storageId], references: [id])

  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  stockMovements InventoryStockMovement[]
  reorderAlerts  InventoryReorderAlert[]
  purchaseOrders InventoryPurchaseOrder[]
  grns           InventoryGRN[]
  assetInstances AssetInstance[]
  gds            InventoryGD[]
  gins           InventoryGIN[]
  ginItems       InventoryGINItem[]
  salesInvoices  InventorySalesInvoice[]
  gdns           InventoryGDN[]
  maintenances   InventoryMaintenance[]

  @@index([status])
  @@index([name])
  @@index([assetCondition])
}

model InventoryStockMovement {
  id            Int            @id @default(autoincrement())
  itemId        Int
  item          InventoryItem  @relation(fields: [itemId], references: [id])
  movementType  String
  quantity      Float
  unitRate      Float?
  previousStock Float
  newStock      Float
  referenceType String?
  referenceId   String?
  expiryDate    DateTime?
  note          String?
  createdAt     DateTime       @default(now())

  @@index([itemId, createdAt])
  @@index([movementType])
  @@index([referenceType])
}

model InventoryReorderAlert {
  id           Int            @id @default(autoincrement())
  itemId        Int
  item          InventoryItem  @relation(fields: [itemId], references: [id])
  thresholdQty  Float
  currentQty    Float
  status        String         @default("open")
  message       String
  createdAt     DateTime       @default(now())
  resolvedAt    DateTime?

  @@index([itemId, status])
}

model InventoryDepartment {
  id        Int           @id @default(autoincrement())
  code      String        @unique
  name      String        @unique
  status    String        @default("active")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  gds       InventoryGD[]
  gins      InventoryGIN[]
  gdHeaders InventoryGDHeader[]

  @@index([status])
}

model InventoryDemandCategoryType {
  id        Int           @id @default(autoincrement())
  code      String        @unique
  name      String        @unique
  status    String        @default("active")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  gds       InventoryGD[]

  @@index([status])
}

model InventoryPurchaseOrder {
  id                    Int                  @id @default(autoincrement())
  code                  String               @unique
  supplierId            Int
  supplier              InventorySupplier    @relation(fields: [supplierId], references: [id])
  itemId                Int
  item                  InventoryItem        @relation(fields: [itemId], references: [id])
  categoryId            Int
  category              InventoryCategory    @relation(fields: [categoryId], references: [id])
  subcategoryId         Int
  subcategory           InventorySubcategory @relation(fields: [subcategoryId], references: [id])
  inHandQuantity        Float                @default(0)
  requiredQuantity      Float
  orderedRate           Float?
  expectedDate          DateTime
  poDate                DateTime             @default(now())
  lastPurchaseDate      DateTime?
  lastPurchaseSupplier  String?
  lastPurchaseRate      Float?
  lastPurchaseQuantity  Float?
  status                String               @default("open")
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  grn                   InventoryGRN?

  @@index([supplierId])
  @@index([itemId])
  @@index([status])
}

model InventoryGRN {
  id               Int                  @id @default(autoincrement())
  code             String               @unique
  poId             Int                  @unique
  purchaseOrder    InventoryPurchaseOrder @relation(fields: [poId], references: [id])
  supplierId       Int
  supplier         InventorySupplier    @relation(fields: [supplierId], references: [id])
  itemId           Int
  item             InventoryItem        @relation(fields: [itemId], references: [id])
  categoryId       Int
  category         InventoryCategory    @relation(fields: [categoryId], references: [id])
  subcategoryId    Int
  subcategory      InventorySubcategory @relation(fields: [subcategoryId], references: [id])
  orderedQuantity  Float
  orderedRate      Float
  receivedQuantity Float
  receivedRate     Float
  retailPrice      Float?
  totalAmount      Float
  receivedDate     DateTime
  billDate         DateTime?
  paymentType      String               @default("cash")
  paymentNote      String?
  isPaid           Boolean              @default(false)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  assetInstances AssetInstance[]

  @@index([receivedDate])
  @@index([supplierId])
  @@index([categoryId, subcategoryId])
}

model EmployeeSalaryPayment {
  id          Int      @id @default(autoincrement())
  empCode     String
  salaryMonth String
  salaryYear  String
  voucherNo   String
  paidAt      DateTime @default(now())

  @@unique([empCode, salaryMonth, salaryYear])
}

model InventoryGD {
  id                    Int                        @id @default(autoincrement())
  code                  String                     @unique
  itemId                Int
  item                  InventoryItem              @relation(fields: [itemId], references: [id])
  departmentId          Int
  department            InventoryDepartment        @relation(fields: [departmentId], references: [id])
  demandCategoryTypeId  Int
  demandCategoryType    InventoryDemandCategoryType @relation(fields: [demandCategoryTypeId], references: [id])
  quantityRequested     Float
  requestDate           DateTime
  status                String                     @default("open")
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt

  gdHeaderId            Int?
  gdHeader              InventoryGDHeader?         @relation(fields: [gdHeaderId], references: [id])

  gins                  InventoryGIN[]
  ginItems              InventoryGINItem[]

  @@index([requestDate])
  @@index([departmentId])
  @@index([status])
  @@index([gdHeaderId])
}

model InventoryGIN {
  id              Int                  @id @default(autoincrement())
  code            String               @unique
  gdId            Int?
  gd              InventoryGD?         @relation(fields: [gdId], references: [id])
  gdHeaderId      Int?
  gdHeader        InventoryGDHeader?   @relation(fields: [gdHeaderId], references: [id])
  itemId          Int?
  item            InventoryItem?       @relation(fields: [itemId], references: [id])
  departmentId    Int
  department      InventoryDepartment  @relation(fields: [departmentId], references: [id])
  issuedById      Int?
  issuedBy        Employee?            @relation(fields: [issuedById], references: [id])
  issuedQuantity  Float?
  issueDate       DateTime
  admissionNumber String?
  status          String               @default("issued")
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  ginItems       InventoryGINItem[]

  @@index([issueDate])
  @@index([departmentId])
  @@index([gdHeaderId])
}

model InventoryGDHeader {
  id              Int                 @id @default(autoincrement())
  code            String              @unique
  departmentId    Int
  department      InventoryDepartment @relation(fields: [departmentId], references: [id])
  status          String              @default("open")
  requestDate     DateTime
  admissionNumber String?
  comment         String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  gdItems       InventoryGD[]
  gins          InventoryGIN[]
  notifications GdNotification[]

  @@index([requestDate])
  @@index([departmentId])
  @@index([status])
}

model GdNotification {
  id          Int               @id @default(autoincrement())
  gdHeaderId  Int
  gdHeader    InventoryGDHeader @relation(fields: [gdHeaderId], references: [id])
  isRead      Boolean           @default(false)
  createdAt   DateTime          @default(now())

  @@index([isRead])
  @@index([gdHeaderId])
}

model InventoryGINItem {
  id             Int           @id @default(autoincrement())
  ginId          Int
  gin            InventoryGIN  @relation(fields: [ginId], references: [id])
  gdItemId       Int?
  gdItem         InventoryGD?  @relation(fields: [gdItemId], references: [id])
  itemId         Int
  item           InventoryItem @relation(fields: [itemId], references: [id])
  issuedQuantity Float
  createdAt      DateTime      @default(now())

  @@index([ginId])
  @@index([itemId])
}

model InventorySalesInvoiceHeader {
  id              Int                      @id @default(autoincrement())
  code            String                   @unique
  invoiceDate     DateTime                 @default(now())
  customerType    String
  customerName    String?
  subTotal        Float                    @default(0)
  discountPercent Float                    @default(0)
  discountAmount  Float                    @default(0)
  totalAmount     Float                    @default(0)
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  items        InventorySalesInvoice[]

  @@index([invoiceDate])
  @@index([customerType])
}

model InventorySalesInvoice {
  id              Int                            @id @default(autoincrement())
  code            String                         @unique
  headerId        Int?
  header          InventorySalesInvoiceHeader?   @relation(fields: [headerId], references: [id])
  itemId          Int
  item            InventoryItem                  @relation(fields: [itemId], references: [id])
  invoiceDate     DateTime                       @default(now())
  customerType    String
  customerName    String?
  quantity        Float
  purchasePrice   Float
  retailPrice     Float
  markupPercent   Float                          @default(0)
  saleRate        Float
  totalAmount     Float
  createdAt       DateTime                       @default(now())
  updatedAt       DateTime                       @updatedAt

  @@index([invoiceDate])
  @@index([itemId])
  @@index([customerType])
  @@index([headerId])
}

model InventoryGDN {
  id              Int                   @id @default(autoincrement())
  code            String                @unique
  itemId          Int
  item            InventoryItem         @relation(fields: [itemId], references: [id])
  quantity        Float
  reason          String
  scrapValue      Float?
  discardedDate   DateTime              @default(now())
  maintenanceId   Int?
  maintenance     InventoryMaintenance? @relation(fields: [maintenanceId], references: [id])
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([discardedDate])
  @@index([itemId])
  @@index([maintenanceId])
}

model InventoryMaintenance {
  id             Int               @id @default(autoincrement())
  moNumber       String?           @unique
  itemId         Int
  item           InventoryItem     @relation(fields: [itemId], references: [id])
  supplierId     Int
  supplier       InventorySupplier @relation(fields: [supplierId], references: [id])
  natureOfRepair String
  cost           Float?
  actualCost     Float?
  date           DateTime
  status         String            @default("in_repair")
  receivedDate   DateTime?
  checkedBy      String?
  warrantyDays   Int?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  assetInstances AssetInstance[]
  gdns           InventoryGDN[]

  @@index([itemId])
  @@index([supplierId])
  @@index([date])
  @@index([status])
}

model AssetInstance {
  id            Int                   @id @default(autoincrement())
  assetTag      String                @unique
  itemId        Int
  item          InventoryItem         @relation(fields: [itemId], references: [id])
  grnId         Int?
  grn           InventoryGRN?         @relation(fields: [grnId], references: [id])
  maintenanceId Int?
  maintenance   InventoryMaintenance? @relation(fields: [maintenanceId], references: [id])
  condition     String                @default("working")
  location      String?
  serialNumber  String?
  notes         String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@index([itemId])
  @@index([condition])
}

// ─── Clinic Module ────────────────────────────────────────────────────────────

model ClinicDepartment {
  id          Int                   @id @default(autoincrement())
  code        String                @default("")
  name        String                @unique
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  subDepartments ClinicSubDepartment[]
  billHeads      ClinicBillHead[]
}

model ClinicSubDepartment {
  id           Int                   @id @default(autoincrement())
  code         String                @default("")
  name         String
  departmentId Int
  department   ClinicDepartment      @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  doctorSubDepts  ClinicDoctorSubDept[]
  opdVisitDoctors ClinicOpdVisitDoctor[]
  panelRates      ClinicPanelSubDeptRate[]
  empSubDeptRates ClinicPanelEmpSubDeptRate[]

  @@unique([departmentId, name])
  @@index([departmentId])
}

model ClinicSurgeryType {
  id        Int      @id @default(autoincrement())
  code      String   @unique @default("")
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ClinicStaffCategory {
  id        Int            @id @default(autoincrement())
  name      String         @unique
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  doctors       ClinicDoctor[]
  billHeadCats  ClinicBillHeadStaffCat[]
}

model ClinicDoctor {
  id              Int                   @id @default(autoincrement())
  code            String                @unique
  name            String
  speciality      String?
  qualification   String?
  staffCategoryId Int?
  staffCategory   ClinicStaffCategory?  @relation(fields: [staffCategoryId], references: [id])
  status          String                @default("active")
  consultantDays  String[]
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  subDepts        ClinicDoctorSubDept[]
  opdVisitDoctors ClinicOpdVisitDoctor[]
}

model ClinicDoctorSubDept {
  id             Int                 @id @default(autoincrement())
  doctorId       Int
  doctor         ClinicDoctor        @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  subDeptId      Int
  subDept        ClinicSubDepartment @relation(fields: [subDeptId], references: [id])
  fromTime       String?
  toTime         String?
  normalCharges  Float               @default(0)
  oddCharges     Float               @default(0)
  paymentType    String              @default("amount")
  normalFees     Float               @default(0)
  oddFees        Float               @default(0)
  onCall         Boolean             @default(false)
  consultantDays String[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([doctorId])
  @@index([subDeptId])
}

// ─── Clinic OPD ───────────────────────────────────────────────────────────────

model ClinicOpdVisit {
  id            Int                    @id @default(autoincrement())
  serialNo      String                 @unique
  mrNo          Int?
  patientType   String                 @default("MAST")
  patientName   String                 @default("")
  admitPatient  Boolean                @default(false)
  antenatal     Boolean                @default(false)
  antenatalNo   String?
  age           Int?
  ageMonths     Int                    @default(0)
  ageDays       Int                    @default(0)
  gender        String                 @default("male")
  phoneNo       String?
  referredBy    String?
  paymentType   String                 @default("cash")
  visitType     String                 @default("opd")
  onCall        Boolean                @default(false)
  employeeId      Int?
  employeeName    String?
  totalAmount     Float                  @default(0)
  discount        Float                  @default(0)
  receive         Float                  @default(0)
  refund          Float                  @default(0)
  panelCompanyId  Int?
  panelEmployeeId Int?
  panelDependentId Int?
  department      String                 @default("General OPD")
  printCount      Int                    @default(0)
  status          String                 @default("active")
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  doctors         ClinicOpdVisitDoctor[]

  @@index([createdAt])
}

model ClinicOpdVisitDoctor {
  id          Int                 @id @default(autoincrement())
  visitId     Int
  visit       ClinicOpdVisit      @relation(fields: [visitId], references: [id], onDelete: Cascade)
  doctorId    Int
  doctor      ClinicDoctor        @relation(fields: [doctorId], references: [id])
  subDeptId   Int
  subDept     ClinicSubDepartment @relation(fields: [subDeptId], references: [id])
  amount      Float               @default(0)
  extAmount   Float               @default(0)
  createdAt   DateTime            @default(now())
}

// ─── Clinic Room & Bed ────────────────────────────────────────────────────────

model ClinicRoomCategory {
  id        Int         @id @default(autoincrement())
  code      String      @unique @default("")
  name      String      @unique
  rate      Float       @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  beds              ClinicBed[]
  billHeadWards     ClinicBillHeadWard[]
  panelEntitlements ClinicPanelRoomEntitlement[]
  empRoomEntitlements ClinicPanelEmpRoomEntitlement[]
}

model ClinicBed {
  id             Int                @id @default(autoincrement())
  name           String
  roomCategoryId Int
  roomCategory   ClinicRoomCategory @relation(fields: [roomCategoryId], references: [id], onDelete: Cascade)
  status         String             @default("available")
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([roomCategoryId, name])
  @@index([roomCategoryId])
}

// ─── Clinic Admission ─────────────────────────────────────────────────────────

model ClinicAdmission {
  id                 Int      @id @default(autoincrement())
  admissionNo        String
  mrNo               Int?
  arrivedSlipNo      String?
  patientTitle       String   @default("Mr")
  patientCategory    String   @default("private")
  patientName        String   @default("")
  ageYears           Int      @default(0)
  ageMonths          Int      @default(0)
  ageDays            Int      @default(0)
  gender             String   @default("male")
  address            String?
  phoneNo            String?
  arrivedUnderRmo    String?
  consultantId       Int?
  referredBy         String?
  authorityLetter    Boolean  @default(false)
  responsibleParty   String?
  previousAdmission  String?
  advancePayment     Decimal? @db.Decimal(10, 2)
  roomCategoryId     Int?
  bedId              Int?
  surgery            Boolean  @default(false)
  surgeryTypeId      Int?
  referralPatient    Boolean  @default(false)
  referralNote       String?
  antenatal          Boolean  @default(false)
  antenatalNo        String?
  status             String   @default("active")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// ─── Clinic Bill Head ─────────────────────────────────────────────────────────

model ClinicBillHead {
  id                    Int                      @id @default(autoincrement())
  headCode              String                   @unique
  accountReceivable     String?
  description           String                   @default("")
  type                  String                   @default("both")
  refDepartmentId       Int?
  refDepartment         ClinicDepartment?        @relation(fields: [refDepartmentId], references: [id])
  staffCategoryRequired Boolean                  @default(false)
  discountApply         Boolean                  @default(false)
  discountSeq           Int                      @default(0)
  status                String                   @default("active")
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  wardRates          ClinicBillHeadWard[]
  staffCategories    ClinicBillHeadStaffCat[]
  panelRates         ClinicPanelAdmissionRate[]
  empAdmissionRates  ClinicPanelEmpAdmissionRate[]
}

model ClinicBillHeadWard {
  id             Int                @id @default(autoincrement())
  billHeadId     Int
  billHead       ClinicBillHead     @relation(fields: [billHeadId], references: [id], onDelete: Cascade)
  roomCategoryId Int
  roomCategory   ClinicRoomCategory @relation(fields: [roomCategoryId], references: [id])
  enabled        Boolean            @default(true)
  rate           Float              @default(0)
  unit           String?
  status         String             @default("active")
  payContractor  Boolean            @default(false)
  disSeq         Int                @default(0)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([billHeadId, roomCategoryId])
  @@index([billHeadId])
}

model ClinicBillHeadStaffCat {
  id              Int                 @id @default(autoincrement())
  billHeadId      Int
  billHead        ClinicBillHead      @relation(fields: [billHeadId], references: [id], onDelete: Cascade)
  staffCategoryId Int
  staffCategory   ClinicStaffCategory @relation(fields: [staffCategoryId], references: [id], onDelete: Cascade)

  @@unique([billHeadId, staffCategoryId])
}

// ─── Clinic Panel ─────────────────────────────────────────────────────────────

model ClinicPanelCompany {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String
  billingTo String   @default("same")
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subDeptRates     ClinicPanelSubDeptRate[]
  admissionRates   ClinicPanelAdmissionRate[]
  roomEntitlements ClinicPanelRoomEntitlement[]
  employees        ClinicPanelEmployee[]        @relation("PanelCompanyEmployees")
  billEmployees    ClinicPanelEmployee[]        @relation("BillCompanyEmployees")
}

model ClinicPanelSubDeptRate {
  id             Int                 @id @default(autoincrement())
  panelCompanyId Int
  panelCompany   ClinicPanelCompany  @relation(fields: [panelCompanyId], references: [id], onDelete: Cascade)
  subDeptId      Int
  subDept        ClinicSubDepartment @relation(fields: [subDeptId], references: [id])
  enabled        Boolean             @default(true)
  rate           Float               @default(0)
  status         String              @default("active")

  @@unique([panelCompanyId, subDeptId])
  @@index([panelCompanyId])
}

model ClinicPanelAdmissionRate {
  id             Int                @id @default(autoincrement())
  panelCompanyId Int
  panelCompany   ClinicPanelCompany @relation(fields: [panelCompanyId], references: [id], onDelete: Cascade)
  billHeadId     Int
  billHead       ClinicBillHead     @relation(fields: [billHeadId], references: [id])
  enabled        Boolean            @default(true)
  rate           Float              @default(0)
  status         String             @default("active")

  @@unique([panelCompanyId, billHeadId])
  @@index([panelCompanyId])
}

model ClinicPanelRoomEntitlement {
  id             Int                @id @default(autoincrement())
  panelCompanyId Int
  panelCompany   ClinicPanelCompany @relation(fields: [panelCompanyId], references: [id], onDelete: Cascade)
  roomCategoryId Int
  roomCategory   ClinicRoomCategory @relation(fields: [roomCategoryId], references: [id])
  enabled        Boolean            @default(true)

  @@unique([panelCompanyId, roomCategoryId])
  @@index([panelCompanyId])
}

// ─── Clinic Panel Employees ───────────────────────────────────────────────────

model ClinicPanelEmployee {
  id             Int                @id @default(autoincrement())
  companyId      Int
  company        ClinicPanelCompany @relation("PanelCompanyEmployees", fields: [companyId], references: [id], onDelete: Cascade)
  empCode        String             @unique
  title          String             @default("MR")
  name           String
  dob            DateTime?
  compCardNo     String?
  billCompanyId  Int?
  billCompany    ClinicPanelCompany? @relation("BillCompanyEmployees", fields: [billCompanyId], references: [id])
  gender         String             @default("male")
  insuranceExpOn DateTime?
  entitlement    String             @default("general")
  status         String             @default("active")
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  dependents       ClinicPanelEmployeeDependent[]
  subDeptRates     ClinicPanelEmpSubDeptRate[]
  admissionRates   ClinicPanelEmpAdmissionRate[]
  roomEntitlements ClinicPanelEmpRoomEntitlement[]
}

model ClinicPanelEmployeeDependent {
  id         Int                 @id @default(autoincrement())
  employeeId Int
  employee   ClinicPanelEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  code       String
  title      String              @default("MR")
  name       String
  relation   String
  dob        DateTime?
  gender     String              @default("male")
  status     String              @default("active")

  @@index([employeeId])
}

model ClinicPanelEmpSubDeptRate {
  id         Int                 @id @default(autoincrement())
  employeeId Int
  employee   ClinicPanelEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  subDeptId  Int
  subDept    ClinicSubDepartment @relation(fields: [subDeptId], references: [id])
  enabled    Boolean             @default(true)
  rate       Float               @default(0)
  status     String              @default("active")

  @@unique([employeeId, subDeptId])
  @@index([employeeId])
}

model ClinicPanelEmpAdmissionRate {
  id         Int                 @id @default(autoincrement())
  employeeId Int
  employee   ClinicPanelEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  billHeadId Int
  billHead   ClinicBillHead      @relation(fields: [billHeadId], references: [id])
  enabled    Boolean             @default(true)
  rate       Float               @default(0)
  status     String              @default("active")

  @@unique([employeeId, billHeadId])
  @@index([employeeId])
}

model ClinicPanelEmpRoomEntitlement {
  id             Int                 @id @default(autoincrement())
  employeeId     Int
  employee       ClinicPanelEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  roomCategoryId Int
  roomCategory   ClinicRoomCategory  @relation(fields: [roomCategoryId], references: [id])
  enabled        Boolean             @default(true)

  @@unique([employeeId, roomCategoryId])
  @@index([employeeId])
}

model ClinicAntenatal {
  id               Int       @id @default(autoincrement())
  mrNo             String    @default("")
  antenatalNo      String    @default("")
  registrationDate DateTime  @db.Date @default(now())
  paymentType      String    @default("private")
  patientName      String    @default("")
  age              Int?
  husbandName      String?
  phoneNo          String?
  address          String?
  lmpDate          DateTime? @db.Date
  edd              DateTime? @db.Date
  underTreatmentId Int?
  para             Int?      @default(0)
  gravidia         Int?      @default(0)
  amount           Decimal?  @db.Decimal(10, 2)
  employeeId       Int?
  panelCompanyId   Int?
  panelEmployeeId  Int?
  panelDependentId Int?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

// ─── Accounts Module ──────────────────────────────────────────────────────────

model AccMainGL {
  id          Int        @id @default(autoincrement())
  code        String     @unique
  name        String
  entityType  String     @default("non-corporate")
  createdAt   DateTime   @default(now())
  subGLs      AccSubGL[]
}

model AccSubGL {
  id         Int              @id @default(autoincrement())
  code       String           @unique
  name       String
  mainGlId   Int
  entityType String           @default("non-corporate")
  createdAt  DateTime         @default(now())
  mainGL     AccMainGL        @relation(fields: [mainGlId], references: [id], onDelete: Cascade)
  mainAccounts AccMainAccount[]
}

model AccMainAccount {
  id         Int             @id @default(autoincrement())
  code       String          @unique
  name       String
  subGlId    Int
  entityType String          @default("non-corporate")
  createdAt  DateTime        @default(now())
  subGL      AccSubGL        @relation(fields: [subGlId], references: [id], onDelete: Cascade)
  subAccounts AccSubAccount[]
}

model AccSubAccount {
  id            Int                    @id @default(autoincrement())
  code          String                 @unique
  name          String
  mainAccountId Int
  entityType    String                 @default("non-corporate")
  createdAt     DateTime               @default(now())
  mainAccount    AccMainAccount         @relation(fields: [mainAccountId], references: [id], onDelete: Cascade)
  payeeHeadLinks AccPayeeHeadAccount[]
  payeeEntries   AccPayeeEntry[]
}

model AccPayeeHead {
  id             Int                    @id @default(autoincrement())
  name           String
  sourceType     String                 @default("manual")
  entityType     String                 @default("non-corporate")
  createdAt      DateTime               @default(now())
  entries        AccPayeeEntry[]
  linkedAccounts AccPayeeHeadAccount[]
}

model AccPayeeHeadAccount {
  id           Int           @id @default(autoincrement())
  payeeHeadId  Int
  subAccountId Int
  createdAt    DateTime      @default(now())
  payeeHead    AccPayeeHead  @relation(fields: [payeeHeadId], references: [id], onDelete: Cascade)
  subAccount   AccSubAccount @relation(fields: [subAccountId], references: [id], onDelete: Cascade)

  @@unique([payeeHeadId, subAccountId])
}

model AccPayeeEntry {
  id           Int            @id @default(autoincrement())
  payeeHeadId  Int
  subAccountId Int?
  name         String
  createdAt    DateTime       @default(now())
  payeeHead    AccPayeeHead   @relation(fields: [payeeHeadId], references: [id], onDelete: Cascade)
  subAccount   AccSubAccount? @relation(fields: [subAccountId], references: [id], onDelete: Cascade)
}

model AccBankAccount {
  id            Int               @id @default(autoincrement())
  bankName      String
  accountNumber String
  entityType    String            @default("non-corporate")
  createdAt     DateTime          @default(now())
  chequeSerials AccChequeSerial[]
  deposits      AccBankDeposit[]
  depositAdjs   AccBankDepositAdj[]
}

model AccBankDeposit {
  id              Int            @id @default(autoincrement())
  bankAccountId   Int
  depositOf       DateTime
  depositDate     DateTime
  depositSlipNo   String?
  depositedBy     String?
  amount          Decimal        @db.Decimal(15, 2)
  entityType      String         @default("non-corporate")
  createdAt       DateTime       @default(now())
  bankAccount     AccBankAccount @relation(fields: [bankAccountId], references: [id])
}

model AccBankDepositAdj {
  id                    Int            @id @default(autoincrement())
  bankAccountId         Int
  postedDepositOf       DateTime
  postedDepositDate     DateTime
  postedDepositSlipNo   String?
  postedDepositedBy     String?
  postedAmount          Decimal        @db.Decimal(15, 2)
  adjDepositDate        DateTime
  adjDepositSlipNo      String?
  adjDepositedBy        String?
  adjAmount             Decimal        @db.Decimal(15, 2)
  adjustedBy            String?
  entityType            String         @default("non-corporate")
  createdAt             DateTime       @default(now())
  bankAccount           AccBankAccount @relation(fields: [bankAccountId], references: [id])
}

model AccChequeSerial {
  id            Int            @id @default(autoincrement())
  bankAccountId Int
  fromSerial    String
  toSerial      String
  createdAt     DateTime       @default(now())
  bankAccount   AccBankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
}

model AccIncomeCategory {
  id         Int      @id @default(autoincrement())
  name       String
  entityType String   @default("non-corporate")
  createdAt  DateTime @default(now())
}

model AccVoucherExpense {
  id          Int                      @id @default(autoincrement())
  voucherNo   String                   @unique
  voucherType String
  voucherDate DateTime
  mode        String
  bankId      Int?
  entityType  String
  totalAmount Decimal                  @db.Decimal(12, 2) @default(0)
  createdAt   DateTime                 @default(now())
  entries     AccVoucherExpenseEntry[]
}

model AccVoucherExpenseEntry {
  id            Int               @id @default(autoincrement())
  voucherId     Int
  voucher       AccVoucherExpense @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  mainGlId      Int
  subGlId       Int
  mainAccountId Int
  subAccountId  Int?
  accountCode   String
  accountName   String
  payeeName     String?
  amount        Decimal           @db.Decimal(12, 2)
  chequeNo      String?
  chequeDate    DateTime?
  chequeType    String?
  particulars   String?
  createdAt     DateTime          @default(now())
}

model AccVoucherIncome {
  id          Int                     @id @default(autoincrement())
  voucherNo   String                  @unique
  voucherType String
  voucherDate DateTime
  mode        String
  bankId      Int?
  entityType  String
  totalAmount Decimal                 @db.Decimal(12, 2) @default(0)
  createdAt   DateTime                @default(now())
  entries     AccVoucherIncomeEntry[]
}

model AccVoucherIncomeEntry {
  id                  Int              @id @default(autoincrement())
  voucherId           Int
  voucher             AccVoucherIncome @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  incomeCategoryId    Int?
  incomeCategoryName  String?
  amount              Decimal          @db.Decimal(12, 2)
  particulars         String?
  createdAt           DateTime         @default(now())
}

model PayslipSnapshot {
  id        Int      @id @default(autoincrement())
  empCode   String   @map("emp_code") @db.VarChar(50)
  month     String   @db.VarChar(2)
  year      String   @db.VarChar(4)
  rowsJson  String   @map("rows_json")
  savedAt   DateTime @default(now()) @map("saved_at")
  netSalary Decimal? @default(0) @map("net_salary") @db.Decimal(12, 2)

  @@unique([empCode, month, year])
  @@map("payslip_snapshots")
}

model PatientVisit {
  id             Int      @id @default(autoincrement())
  serialNo       Int?
  admitNo        Int?
  visitDate      DateTime @db.Date
  visitTime      String?
  patientName    String
  department     String?
  subDepartment  String?
  doctor         String?
  paymentType    String?
  received       Decimal  @default(0) @db.Decimal(10, 2)
  balance        Decimal  @default(0) @db.Decimal(10, 2)
  discount       Decimal  @default(0) @db.Decimal(10, 2)
  isPaid         Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([visitDate])
  @@index([admitNo])
  @@index([department])
  @@index([doctor])
  @@index([paymentType])
}

model ConsultantRate {
  id             Int      @id @default(autoincrement())
  consultantName String   @unique
  rate           Decimal  @default(0) @db.Decimal(5, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model AttendanceOverride {
  id               String   @id
  empCode          String   @map("emp_code")
  dateIn           DateTime @map("date_in") @db.Date
  dateOut          DateTime? @map("date_out") @db.Date
  timeIn           String?  @map("time_in")
  timeOut          String?  @map("time_out")
  status           String   @default("present")
  manualWrkHrs     Float?   @map("manual_wrk_hrs")
  manualOvertime   Float?   @map("manual_overtime")
  manualDeduction  Float?   @map("manual_deduction")
  manualTotal      Float?   @map("manual_total")
  waiveDeduction   Boolean  @default(false) @map("waive_deduction")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  isLocked         Boolean  @default(false) @map("is_locked")
  isManuallyEdited Boolean  @default(false) @map("is_manually_edited")

  @@map("attendance_overrides")
}

// ─── Panel Bill Comparison ────────────────────────────────────────────────────

model ClinicPanelBillRow {
  id              Int      @id @default(autoincrement())
  sno             Int?
  admitNo         String?
  patientName     String   @default("")
  employeeName    String?
  companyName     String?
  panelCompanyId  Int?
  panelEmployeeId Int?
  relation        String   @default("SELF")
  amount          Decimal? @db.Decimal(12, 2)
  billAmount      Decimal? @db.Decimal(12, 2)
  diff            Decimal? @db.Decimal(12, 2)
  uploadedAt      DateTime @default(now())
}

// Panel Billing Detail (bill-head wise) — "all panal pt bills details bill head wise" Excel
model ClinicPanelBillingDetail {
  id              Int       @id @default(autoincrement())
  admitNo         String?
  patientName     String    @default("")
  consCode        String?
  companyName     String?
  panelCompanyId  Int?
  constFee        Decimal?  @db.Decimal(14, 2)
  followUp        Decimal?  @db.Decimal(14, 2)
  anesthesia      Decimal?  @db.Decimal(14, 2)
  medicine        Decimal?  @db.Decimal(14, 2)
  laboratory      Decimal?  @db.Decimal(14, 2)
  costOfBlood     Decimal?  @db.Decimal(14, 2)
  echocardiograph Decimal?  @db.Decimal(14, 2)
  ultrasound      Decimal?  @db.Decimal(14, 2)
  xRay            Decimal?  @db.Decimal(14, 2)
  physiotherapy   Decimal?  @db.Decimal(14, 2)
  ctScan          Decimal?  @db.Decimal(14, 2)
  surgeonFee      Decimal?  @db.Decimal(14, 2)
  totalAmount     Decimal?  @db.Decimal(14, 2)
  periodFrom      DateTime?
  periodTo        DateTime?
  uploadedAt      DateTime  @default(now())

  @@index([admitNo])
  @@index([companyName])
  @@index([consCode])
}

// Death Certificate — linked to an admission; everything except the admission
// snapshot (admissionNo/arrivedSlipNo/patientName/age/gender) is filled manually.
model ClinicDeathCertificate {
  id              Int      @id @default(autoincrement())
  admissionId     Int?
  admissionNo     String
  arrivedSlipNo   String?
  patientName     String   @default("")
  ageYears        Int      @default(0)
  ageMonths       Int      @default(0)
  ageDays         Int      @default(0)
  gender          String   @default("male")
  deathTime       DateTime?
  deathPlace      String?
  relationType    String   @default("S/o")
  relationName    String?
  religion        String?
  occupation      String?
  causeOfDeath    String?
  medicalOfficerId Int?
  drAddress       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([admissionNo])
}
